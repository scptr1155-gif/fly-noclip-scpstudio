local lastFetchError = ""

local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" then return res end
    lastFetchError = tostring(res)

    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local ok2, r = pcall(req, {Url = url, Method = "GET"})
        if ok2 and r then
            if r.StatusCode == 200 and type(r.Body) == "string" then return r.Body end
            lastFetchError = "HTTP " .. tostring(r.StatusCode)
        end
    end
    return nil
end

local function fetchFile(url)
    local res = httpGet(url .. "?t=" .. tostring(os.time()))
    if not res then res = httpGet(url) end
    if not res then return nil end
    res = res:gsub("^\239\187\191", "")
    if res:match("^404: Not Found") then
        lastFetchError = "404 not found"
        return nil
    end
    return res
end

local function fetchLists()
    local u = fetchFile(URL_KEY)
    local a = fetchFile(URL_ADMIN)
    if not u and not a then
        warn("[cr-game] " .. lastFetchError)
        return nil
    end
    if (u or ""):match("^%s*$") and (a or ""):match("^%s*$") then
        lastFetchError = "empty file"
        warn("[cr-game] key files are empty")
        return nil
    end
    return {user = u, admin = a}
end

local function keyExists(keys, input)
    if not keys then return false end
    for line in keys:gmatch("[^\r\n]+") do
        if (line:gsub("%s+", "")) == input then return true end
    end
    return false
end

-- "admin" / "user" / "error" (dosya okunamadı) / nil (geçersiz)
local function keyRole(lists, input)
    if keyExists(lists.admin, input) then return "admin" end
    if keyExists(lists.user, input) then return "user" end
    if lists.admin == nil or lists.user == nil then return "error" end
    return nil
end

