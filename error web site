local CONFIG_FILE = "crgame_config.json"
local cfg = {}

local function canFS()
    return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end
local function loadCfg()
    if not canFS() then return end
    local ok, data = pcall(function()
        if isfile(CONFIG_FILE) then return HttpService:JSONDecode(readfile(CONFIG_FILE)) end
    end)
    if ok and type(data) == "table" then cfg = data end
end
local function saveCfg()
    if not canFS() then return end
    pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(cfg)) end)
end
getgenv().CR_SaveLang = function(code)
    cfg.lang = code
    saveCfg()
end

