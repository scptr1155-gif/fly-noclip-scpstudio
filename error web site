    return function()
        alive = false
        if gui then pcall(function() gui:Destroy() end) end
    end
end

--------------------------------------------------------------------
-- Başlangıç (korumalı)
--------------------------------------------------------------------
local function start()
    loadCfg()
    getgenv().CR_LANG = cfg.lang

    local closeLoading = showLoading()
    local startedAt = os.clock()

    -- Key kontrolü loading sırasında yapılır
    local lists = fetchLists()

    -- Loading en az 1 sn görünsün
    local left = 1 - (os.clock() - startedAt)
    if left > 0 then task.wait(left) end
    closeLoading()

    if cfg.lang and cfg.key then
        -- Daha önce girilmiş key var: hâlâ listede mi?
        if not lists then
            openGate(getError("code_load_failed") .. " (" .. lastFetchError .. ")")
            return
        end
        local role = keyRole(lists, cfg.key)
        if role == "admin" or role == "user" then
            getgenv().CR_ROLE = role
            launch()            -- key hâlâ duruyor: direkt script
        elseif role == "error" then
            openGate(getError("code_load_failed") .. " (" .. lastFetchError .. ")")
        else
            cfg.key = nil       -- key silinmiş: key menüsü
            saveCfg()
            openGate(getError("key_removed"))
        end
    else
        -- Hiç key girilmemiş: (dil seçimi ->) key menüsü
        openGate()
    end
end

local ok, err = pcall(start)
if not ok then
    warn("[cr-game] start error: " .. tostring(err))
    local ok2, err2 = pcall(function()
        cfg = {}
        openGate()
    end)
    if not ok2 then warn("[cr-game] gui error: " .. tostring(err2)) end
end
