local openGate, launch, startWatcher

function startWatcher()
    getgenv().CR_WATCH = (getgenv().CR_WATCH or 0) + 1
    local id = getgenv().CR_WATCH
    task.spawn(function()
        while true do
            task.wait(60)
            if getgenv().CR_WATCH ~= id then return end
            local ok, lists = pcall(fetchLists)
            if ok and lists and cfg.key then
                local role = keyRole(lists, cfg.key)
                if role == nil then
                    cfg.key = nil
                    saveCfg()
                    getgenv().CR_ROLE = nil
                    if getgenv().CR_Close then pcall(getgenv().CR_Close) end
                    openGate(getError("key_removed"))
                    return
                elseif role ~= "error" then
                    getgenv().CR_ROLE = role
                end
            end
        end
    end)
end

function launch()
    local ok, err = pcall(function() loadstring(game:HttpGet(URL_SCRIPT))() end)
    if not ok then
        warn("[cr-game] " .. tostring(err))
        openGate(getError("script_load_failed"))
        return false
    end
    startWatcher()
    return true
end

