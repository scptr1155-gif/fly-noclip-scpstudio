local function stopFly()
	State.Fly = false

	if FlyConn then
		FlyConn:Disconnect()
		FlyConn = nil
	end

	for _, object in pairs(FlyParts) do
		object:Destroy()
	end
	FlyParts = {}
	table.clear(Hold)

	if Humanoid and Humanoid.Parent then
		Humanoid.PlatformStand = false
		if Humanoid.Health > 0 then
			Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

local function startFly()
	if State.Fly or not Root or not Root.Parent or not Humanoid or Humanoid.Health <= 0 then
		return
	end
	State.Fly = true

	local attachment = new(AT, {}, Root)
	local linear = new(LV, {
		Attachment0 = attachment,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		MaxForce = 1e7,
	}, Root)
	linear[VV] = Vector3.zero
	local align = new(AO, {
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		Attachment0 = attachment,
		RigidityEnabled = false,
		MaxTorque = 1e7,
		MaxAngularVelocity = math.huge,
		Responsiveness = 40,
		CFrame = Root.CFrame,
	}, Root)
	FlyParts = {attachment, linear, align}

	Humanoid.PlatformStand = true
	local velocity = Vector3.zero

	FlyConn = RunService.Heartbeat:Connect(function(dt)
		if not Root or not Root.Parent then
			stopFly()
			Refresh()
			return
		end

		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local cf = camera.CFrame
		local typing = UIS:GetFocusedTextBox() ~= nil

		local move = Vector3.zero
		if typing then
			move = Vector3.zero
		elseif Controls then
			move = Controls:GetMoveVector()
		else
			move = Vector3.new(
				(UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0),
				0,
				(UIS:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.W) and 1 or 0)
			)
		end

		local vertical = 0
		if Hold.Up then
			vertical += 1
		end
		if Hold.Down then
			vertical -= 1
		end
		if not typing then
			if UIS:IsKeyDown(Enum.KeyCode.Space) then
				vertical += 1
			end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) then
				vertical -= 1
			end
		end

		local direction = cf.RightVector * move.X - cf.LookVector * move.Z + Vector3.yAxis * math.clamp(vertical, -1, 1)
		if direction.Magnitude > 1 then
			direction = direction.Unit
		end

		velocity = velocity:Lerp(direction * CONFIG.Speed, math.min(1, dt * 10))
		linear[VV] = velocity

		local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if flat.Magnitude > 0.01 then
			align.CFrame = CFrame.lookAt(Vector3.zero, flat)
		end
	end)
end

