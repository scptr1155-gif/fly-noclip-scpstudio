    ClipButton.Text = tr("clip").." : "..(State.NoClip and tr("on") or tr("off"))
    SpeedLabel.Text = tr("speed").." : "..CONFIG.Speed
    LanguageLabel.Text = tr("language").." : "..State.Language
    Subtitle.Text = tr("subtitle")
    Info.Text = tr("info")
    Header.Text = tr("title")

    FlyButton.BackgroundColor3 = State.Fly and Colors.Green or Colors.Button
    ClipButton.BackgroundColor3 = State.NoClip and Colors.Green or Colors.Button
end

