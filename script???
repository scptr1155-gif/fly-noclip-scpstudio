local OriginalCollision = {}

local function stopFly()
    State.Fly = false

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if Velocity then
        Velocity:Destroy()
        Velocity = nil
    end

    if Gyro then
        Gyro:Destroy()
        Gyro = nil
    end

    if Humanoid then
        Humanoid.PlatformStand = false
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function stopClip()
    State.NoClip = false

    if ClipConnection then
        ClipConnection:Disconnect()
        ClipConnection = nil
    end

    for part, original in pairs(OriginalCollision) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end

    table.clear(OriginalCollision)
end

local function startFly()
    if not Root or not Humanoid or Humanoid.Health <= 0 then
        return
    end

    if State.Fly then return end

    State.Fly = true

    Velocity = Instance.new("BodyVelocity")
    Velocity.MaxForce = Vector3.new(1000000,1000000,1000000)
    Velocity.Velocity = Vector3.zero
    Velocity.Parent = Root

    Gyro = Instance.new("BodyGyro")
    Gyro.MaxTorque = Vector3.new(1000000,1000000,1000000)
    Gyro.P = 10000
    Gyro.Parent = Root

    Humanoid.PlatformStand = true

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not State.Fly or not Root or not Root.Parent then
            stopFly()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end

        local direction = Vector3.zero

        if Keys.W then direction += camera.CFrame.LookVector end
        if Keys.S then direction -= camera.CFrame.LookVector end
        if Keys.A then direction -= camera.CFrame.RightVector end
        if Keys.D then direction += camera.CFrame.RightVector end
        if Keys.Up then direction += Vector3.yAxis end
        if Keys.Down then direction -= Vector3.yAxis end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        Velocity.Velocity = direction * CONFIG.Speed

        local look = camera.CFrame.LookVector
        Gyro.CFrame = CFrame.lookAt(Root.Position, Root.Position + look)
    end)
end

local function startClip()
    if not Character or State.NoClip then return end

    State.NoClip = true

    ClipConnection = RunService.Stepped:Connect(function()
        if not Character then return end

        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                if OriginalCollision[part] == nil then
                    OriginalCollision[part] = part.CanCollide
                end

                part.CanCollide = false
            end
        end
    end)
end

local function setupCharacter(char)
    stopFly()
    stopClip()

    Character = char
    Humanoid = char:WaitForChild("Humanoid")
    Root = char:WaitForChild("HumanoidRootPart")

    Humanoid.Died:Connect(function()
        stopFly()
        stopClip()
    end)
end

