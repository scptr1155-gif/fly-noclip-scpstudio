local flying, noclipping = false, false
local bv, bg, flyConn, noclipConn

local function getChar()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return char, hrp, hum
end

local function refreshTexts()
    local t = TEXT[getgenv().CR_LANG]
    flyBtn.Text = t.fly .. ": " .. (flying and t.on or t.off)
    noclipBtn.Text = t.noclip .. ": " .. (noclipping and t.on or t.off)
    flyBtn.BackgroundColor3 = flying and Color3.fromRGB(40, 170, 90) or Color3.fromRGB(60, 60, 80)
    noclipBtn.BackgroundColor3 = noclipping and Color3.fromRGB(40, 170, 90) or Color3.fromRGB(60, 60, 80)
    speedLabel.Text = t.speed
    langBtn.Text = t.lang
    closeBtn.Text = t.close
end

local function stopFly()
    flying = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    local _, _, hum = getChar()
    if hum then hum.PlatformStand = false end
end

local function startFly()
    local _, hrp, hum = getChar()
    if not hrp or not hum then
        status.Text = getError("character_not_found")
        return
    end
    status.Text = ""
    flying = true
    hum.PlatformStand = true

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 9e4
    bg.Parent = hrp

    flyConn = RunService.RenderStepped:Connect(function()
        local _, root, humanoid = getChar()
        if not root or not humanoid or not bv then return end
        local cam = workspace.CurrentCamera
        local speed = tonumber(speedBox.Text) or 60

        local dir = humanoid.MoveDirection * speed
        local vertical = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vertical = speed end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vertical = -speed end

        local look = cam.CFrame.LookVector
        local moveFlat = humanoid.MoveDirection
        local flat = Vector3.new(look.X, 0, look.Z)
        if moveFlat.Magnitude > 0 and flat.Magnitude > 0 then
            local forwardDot = moveFlat:Dot(flat.Unit)
            dir = dir + Vector3.new(0, look.Y * forwardDot * speed, 0)
        end

        bv.Velocity = dir + Vector3.new(0, vertical, 0)
        bg.CFrame = cam.CFrame
    end)
end

local function stopNoclip()
    noclipping = false
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
end

local function startNoclip()
    noclipping = true
    noclipConn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
end

flyBtn.MouseButton1Click:Connect(function()
    if flying then stopFly() else startFly() end
    refreshTexts()
end)

noclipBtn.MouseButton1Click:Connect(function()
    if noclipping then stopNoclip() else startNoclip() end
    refreshTexts()
end)

langBtn.MouseButton1Click:Connect(function()
    getgenv().CR_LANG = (getgenv().CR_LANG == "TR") and "EN" or "TR"
    status.Text = ""
    refreshTexts()
end)

closeBtn.MouseButton1Click:Connect(function()
    stopFly()
    stopNoclip()
    gui:Destroy()
end)

LocalPlayer.CharacterAdded:Connect(function()
    stopFly()
    refreshTexts()
end)

refreshTexts()
