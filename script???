        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.new(0, 16, 0, 16),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, track)
    UI.corner(knob, 8)
    local state = false
    local function set(v)
        state = v
        UI.tween(knob, 0.15, {Position = v and UDim2.new(0, 25, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)})
        UI.tween(track, 0.15, {BackgroundColor3 = v and UI.GREEN1 or Color3.fromRGB(65, 65, 88)})
    end
    track.MouseButton1Click:Connect(function() onChange(not state) end)
    return set
end

