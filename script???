local function setSpeedRel(rel)
    rel = math.clamp(rel, 0, 1)
    speed = math.floor(MINSPD + rel * (MAXSPD - MINSPD))
    fill.Size = UDim2.new(rel, 0, 1, 0)
    knob.Position = UDim2.new(rel, 0, 0.5, 0)
    speedVal.Text = tostring(speed)
end
setSpeedRel((speed - MINSPD) / (MAXSPD - MINSPD))

local sliding = false
local function slideTo(x)
    setSpeedRel((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1))
end
hit.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        slideTo(i.Position.X)
    end
end)
table.insert(conns, UIS.InputChanged:Connect(function(i)
    if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        slideTo(i.Position.X)
    end
end))
table.insert(conns, UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end))

