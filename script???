----------------------------------------------------------------------
-- Yenileme / olaylar
----------------------------------------------------------------------

Refresh = function()
	if Closed then
		return
	end

	Title.Text = tr("title")
	Subtitle.Text = tr("subtitle")
	FlyToggle.Label.Text = tr("fly")
	ClipToggle.Label.Text = tr("clip")
	SpeedLabel.Text = tr("speed")
	LanguageLabel.Text = tr("language")
	if not DiscordBox.Visible and DiscordButton.BackgroundColor3 == Colors.Discord then
		DiscordButton.Text = tr("discord")
	end
	if not DiscordBox.Visible then
		Info.Text = infoText()
	end

	setToggle(FlyToggle, State.Fly)
	setToggle(ClipToggle, State.NoClip)

	for code, button in pairs(LanguageButtons) do
		local active = code == State.Language
		tween(button, 0.25, {
			BackgroundColor3 = active and Colors.Accent or Colors.Button,
			TextColor3 = active and Colors.Text or Colors.Muted,
		})
	end

	if TouchPad and padShown ~= State.Fly then
		padShown = State.Fly
		if padShown then
			for _, button in pairs(PadButtons) do
				button.BackgroundColor3 = Colors.Button
			end
			TouchPad.Visible = true
			PadScale.Scale = 0.6
			tween(PadScale, 0.3, {Scale = 1}, Enum.EasingStyle.Back)
		else
			TouchPad.Visible = false
		end
	end
end

FlyToggle.Row.Activated:Connect(function()
	if State.Fly then
		stopFly()
	else
		startFly()
	end
	Refresh()
end)

ClipToggle.Row.Activated:Connect(function()
	if State.NoClip then
		stopClip()
	else
		startClip()
	end
	Refresh()
end)

Minimize.Activated:Connect(function()
	State.Minimized = not State.Minimized
	local mini = State.Minimized

	Minimize.Text = mini and "+" or "—"
	if not mini then
		Content.Visible = true
	end
	tween(Content, 0.2, {GroupTransparency = mini and 1 or 0})
	tween(Subtitle, 0.2, {TextTransparency = mini and 1 or 0})
	tween(Main, 0.35, {Size = mini and MINI_SIZE or FULL_SIZE}, Enum.EasingStyle.Quint)

	task.delay(0.2, function()
		if not Closed and State.Minimized == mini then
			Content.Visible = not mini
		end
	end)
end)

-- Kapat: her şeyi temizler
Close.Activated:Connect(function()
	if Closed then
		return
	end
	Closed = true

	stopFly()
	stopClip()
	if DiedConn then
		DiedConn:Disconnect()
	end
	for _, conn in ipairs(Conns) do
		conn:Disconnect()
	end
	table.clear(Conns)

	local out = tween(MainScale, 0.25, {Scale = 0}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	out.Completed:Wait()
	Gui:Destroy()
end)

-- Sağ Shift ile gizle / göster
bind(UIS.InputBegan, function(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.RightShift then
		return
	end
	State.Hidden = not State.Hidden
	if State.Hidden then
		local t = tween(MainScale, 0.2, {Scale = 0}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if State.Hidden then
				Main.Visible = false
			end
		end)
	else
		Main.Visible = true
		tween(MainScale, 0.3, {Scale = 1}, Enum.EasingStyle.Back)
	end
end)

-- Pencere sürükleme (ekran dışına çıkmaz)
local dragStart, startPosition
trackDrag(TopBar, function(input)
	dragStart = input.Position
	startPosition = Main.Position
end, function(changed)
	local delta = changed.Position - dragStart
	local view = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
	local maxX = view.X / 2 - 40
	Main.Position = UDim2.new(
		startPosition.X.Scale,
		math.clamp(startPosition.X.Offset + delta.X, -maxX, maxX),
		startPosition.Y.Scale,
		math.clamp(startPosition.Y.Offset + delta.Y, -view.Y / 2, view.Y / 2 - 40)
	)
end)

-- Karakter
local function setupCharacter(char)
	stopFly()
	stopClip()
	if DiedConn then
		DiedConn:Disconnect()
		DiedConn = nil
	end

	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	Root = char:WaitForChild("HumanoidRootPart")

	DiedConn = Humanoid.Died:Connect(function()
		stopFly()
		stopClip()
		Refresh()
	end)
	Refresh()
end

bind(Player.CharacterAdded, setupCharacter)
if Player.Character then
	task.spawn(setupCharacter, Player.Character)
end

