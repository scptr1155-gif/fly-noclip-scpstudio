    CONFIG.Speed = math.max(CONFIG.MinSpeed,CONFIG.Speed-5)
    refresh()
end)

SpeedPlus.Activated:Connect(function()
    CONFIG.Speed = math.min(CONFIG.MaxSpeed,CONFIG.Speed+5)
    refresh()
end)

