	tween(DiscordButton, 0.15, {BackgroundColor3 = color})
	task.delay(1.6, function()
		if id == flashId then
			DiscordButton.Text = tr("discord")
			tween(DiscordButton, 0.25, {BackgroundColor3 = Colors.Discord})
		end
	end)
end

local function hideBox()
	DiscordBox.Visible = false
	Info.Text = infoText()
end

DiscordButton.Activated:Connect(function()
	local clip = (type(setclipboard) == "function" and setclipboard) or (type(toclipboard) == "function" and toclipboard) or nil
	if clip and pcall(clip, INVITE) then
		flashDiscord(tr("copied"), Colors.Green)
		return
	end

	DiscordBox.Text = INVITE
	DiscordBox.Visible = true
	Info.Text = tr("manual")
	pcall(function()
		DiscordBox:CaptureFocus()
		DiscordBox.SelectionStart = 1
		DiscordBox.CursorPosition = #INVITE + 1
	end)
	task.delay(6, function()
		if DiscordBox.Visible and not DiscordBox:IsFocused() then
			hideBox()
		end
	end)
end)

DiscordBox.FocusLost:Connect(hideBox)

-- Mobile up / down buttons (visible only while flying)
local TouchPad, PadScale
local PadButtons = {}
local padShown = false

if UIS.TouchEnabled then
	TouchPad = new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -190),
		Size = UDim2.fromOffset(58, 116),
		BackgroundTransparency = 1,
		Visible = false,
	}, Gui)
	PadScale = new("UIScale", {}, TouchPad)

	local function padButton(symbol, y, key)
		local button = new("TextButton", {
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.fromOffset(58, 52),
			BackgroundColor3 = Colors.Button,
			AutoButtonColor = false,
			Font = Enum.Font.GothamBold,
			Text = symbol,
			TextSize = 22,
			TextColor3 = Colors.Text,
		}, TouchPad)
		corner(button, 14)
		new("UIStroke", {Color = Colors.Accent, Thickness = 1.5}, button)
		button.InputBegan:Connect(function(input)
			if isPointer(input) then
				Hold[key] = input
				tween(button, 0.1, {BackgroundColor3 = Colors.Accent})
			end
		end)
		PadButtons[key] = button
	end

	padButton("▲", 0, "Up")
	padButton("▼", 64, "Down")
end

UIS.InputEnded:Connect(function(input)
	for key, held in pairs(Hold) do
		if held == input then
			Hold[key] = nil
			if PadButtons[key] then
				tween(PadButtons[key], 0.12, {BackgroundColor3 = Colors.Button})
			end
		end
	end
end)

----------------------------------------------------------------------
-- Refresh / events
----------------------------------------------------------------------

Refresh = function()
	Title.Text = tr("title")
	Subtitle.Text = tr("subtitle")
	FlyToggle.Label.Text = tr("fly")
	ClipToggle.Label.Text = tr("clip")
	SpeedLabel.Text = tr("speed")
	LanguageLabel.Text = tr("language")
	DiscordButton.Text = tr("discord")
	Info.Text = infoText()

	setToggle(FlyToggle, State.Fly)
	setToggle(ClipToggle, State.NoClip)

	for code, button in pairs(LanguageButtons) do
		local active = code == State.Language
		tween(button, 0.2, {
			BackgroundColor3 = active and Colors.Accent or Colors.Button,
			TextColor3 = active and Colors.Text or Colors.Muted,
		})
	end

	if TouchPad and padShown ~= State.Fly then
		padShown = State.Fly
		if padShown then
			for _, button in pairs(PadButtons) do
				button.BackgroundColor3 = Colors.Button
			end
			TouchPad.Visible = true
			PadScale.Scale = 0.6
			tween(PadScale, 0.25, {Scale = 1}, Enum.EasingStyle.Back)
		else
			TouchPad.Visible = false
		end
	end
end

FlyToggle.Row.Activated:Connect(function()
	if State.Fly then
		stopFly()
	else
		startFly()
	end
	Refresh()
end)

ClipToggle.Row.Activated:Connect(function()
	if State.NoClip then
		stopClip()
	else
		startClip()
	end
	Refresh()
end)

Minimize.Activated:Connect(function()
	State.Minimized = not State.Minimized
	local mini = State.Minimized

	Minimize.Text = mini and "+" or "—"
	if not mini then
		Content.Visible = true
	end
	tween(Content, 0.2, {GroupTransparency = mini and 1 or 0})
	tween(Subtitle, 0.2, {TextTransparency = mini and 1 or 0})
	tween(Main, 0.3, {Size = mini and MINI_SIZE or FULL_SIZE}, Enum.EasingStyle.Quint)

	task.delay(0.2, function()
		if State.Minimized == mini then
			Content.Visible = not mini
		end
	end)
end)

-- Window dragging
local dragStart, startPosition
trackDrag(TopBar, function(input)
	dragStart = input.Position
	startPosition = Main.Position
end, function(changed)
	local delta = changed.Position - dragStart
	Main.Position = UDim2.new(
		startPosition.X.Scale, startPosition.X.Offset + delta.X,
		startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
	)
end)

-- Character
local function setupCharacter(char)
	stopFly()
	stopClip()

	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	Root = char:WaitForChild("HumanoidRootPart")

	Humanoid.Died:Connect(function()
		stopFly()
		stopClip()
		Refresh()
	end)
	Refresh()
end

Player.CharacterAdded:Connect(setupCharacter)
if Player.Character then
	task.spawn(setupCharacter, Player.Character)
end

setSpeed(CONFIG.Speed)
Refresh()
tween(MainScale, 0.4, {Scale = 1}, Enum.EasingStyle.Back)
