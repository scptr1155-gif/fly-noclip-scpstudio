local function D(t, seed)
	local out, s = {}, seed
	for i = 1, #t do
		s = (s * 75 + 74) % 65537
		out[i] = string.char((bit32.bxor(t[i], s % 256) - i * 7) % 256)
	end
	return table.concat(out)
end

