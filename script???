local function tween(object, duration, props, style)
	local t = TweenService:Create(object, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function corner(object, radius)
	return new("UICorner", {CornerRadius = UDim.new(0, radius)}, object)
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

-- Hover glow + press animation
local function fx(button, radius)
	local glow = new("Frame", {
		Name = "Glow",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.Text,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, button)
	corner(glow, radius)
	local scale = new("UIScale", {}, button)

	button.MouseEnter:Connect(function()
		tween(glow, 0.15, {BackgroundTransparency = 0.9})
	end)
	button.MouseLeave:Connect(function()
		tween(glow, 0.15, {BackgroundTransparency = 1})
		tween(scale, 0.1, {Scale = 1})
	end)
	button.MouseButton1Down:Connect(function()
		tween(scale, 0.08, {Scale = 0.97})
	end)
	button.MouseButton1Up:Connect(function()
		tween(scale, 0.15, {Scale = 1}, Enum.EasingStyle.Back)
	end)
end

-- Generic drag tracking: the global listener only exists while dragging
local function trackDrag(handle, onBegin, onMove)
	handle.InputBegan:Connect(function(input)
		if not isPointer(input) then
			return
		end

		local moveConn, endConn
		local function stop()
			if moveConn then
				moveConn:Disconnect()
				moveConn = nil
			end
			if endConn then
				endConn:Disconnect()
				endConn = nil
			end
		end

		onBegin(input)
		moveConn = UIS.InputChanged:Connect(function(changed)
			if changed.UserInputType == Enum.UserInputType.MouseMovement or changed == input then
				onMove(changed)
			end
		end)
		endConn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				stop()
			end
		end)
	end)
end

