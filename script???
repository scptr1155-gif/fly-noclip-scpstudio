local function infoText()
	return UIS.TouchEnabled and tr("infoTouch") or tr("info")
end

local flashId = 0
local function flashDiscord(text, color)
	flashId += 1
	local id = flashId
	DiscordButton.Text = text
	tween(DiscordButton, 0.15, {BackgroundColor3 = color})
	task.delay(1.6, function()
		if id == flashId and not Closed then
			DiscordButton.Text = tr("discord")
			tween(DiscordButton, 0.3, {BackgroundColor3 = Colors.Discord})
		end
	end)
end

local function hideBox()
	DiscordBox.Visible = false
	Info.Text = infoText()
end

DiscordButton.Activated:Connect(function()
	if not INVITE then
		flashDiscord(tr("failed"), Colors.Red)
		return
	end

	local clip = getGlobal(SC) or getGlobal(TC)
	if type(clip) == "function" and pcall(clip, INVITE) then
		flashDiscord(tr("copied"), Colors.Green)
		return
	end

	DiscordBox.Text = INVITE
	DiscordBox.Visible = true
	Info.Text = tr("manual")
	pcall(function()
		DiscordBox:CaptureFocus()
		DiscordBox.SelectionStart = 1
		DiscordBox.CursorPosition = #INVITE + 1
	end)
	task.delay(6, function()
		if not Closed and DiscordBox.Visible and not DiscordBox:IsFocused() then
			hideBox()
		end
	end)
end)

DiscordBox.FocusLost:Connect(hideBox)

