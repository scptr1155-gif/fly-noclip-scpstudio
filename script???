local function setSpeed(value)
	value = math.clamp(math.floor(value / CONFIG.Step + 0.5) * CONFIG.Step, CONFIG.MinSpeed, CONFIG.MaxSpeed)
	CONFIG.Speed = value
	local ratio = (value - CONFIG.MinSpeed) / (CONFIG.MaxSpeed - CONFIG.MinSpeed)
	Fill.Size = UDim2.fromScale(ratio, 1)
	SliderKnob.Position = UDim2.fromScale(ratio, 0.5)
	SpeedValue.Text = tostring(value)
end

local function sliderFromX(x)
	local width = math.max(Bar.AbsoluteSize.X, 1)
	local ratio = math.clamp((x - Bar.AbsolutePosition.X) / width, 0, 1)
	setSpeed(CONFIG.MinSpeed + ratio * (CONFIG.MaxSpeed - CONFIG.MinSpeed))
end

trackDrag(SliderHit, function(input)
	sliderFromX(input.Position.X)
	tween(SliderKnob, 0.12, {Size = UDim2.fromOffset(21, 21)}, Enum.EasingStyle.Back)
end, function(changed)
	sliderFromX(changed.Position.X)
end)
bind(UIS.InputEnded, function(input)
	if isPointer(input) then
		tween(SliderKnob, 0.2, {Size = UDim2.fromOffset(16, 16)})
	end
end)

