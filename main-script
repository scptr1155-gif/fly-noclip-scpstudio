			AutoButtonColor = false, Font = Enum.Font.GothamBold, Text = code, TextSize = 10, TextColor3 = C.muted,
		}, bar)
		corner(b, 6)
		b.Activated:Connect(function()
			Lang.Set(code)
		end)
		buttons[code] = b
	end
