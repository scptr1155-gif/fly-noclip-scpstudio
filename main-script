-- 12) Anahtar bekçisi (süre dolunca / listeden silinince kilitler)
--------------------------------------------------------------------
task.spawn(function()
	local lastCheck = os.clock()
	while Gui.Parent do
		task.wait(5)
		local expired = nowTime() >= KeyExpiry
		if not expired and os.clock() - lastCheck >= KEY_RECHECK then
			lastCheck = os.clock()
			local keys = fetchKeys()
			if keys then
				local store = loadStore()
				if not store.last or not keys[store.last] then
					expired = true
				end
			end
		end
		if expired then
			stopFly()
			stopClip()
			Main.Visible = false
			Launcher.Visible = false
			Refresh()
			KeyExpiry = runKeyGate(kt("ended"))
			lastCheck = os.clock()
			Main.Visible = not State.Hidden
			Launcher.Visible = State.Hidden
		end
	end
end)

