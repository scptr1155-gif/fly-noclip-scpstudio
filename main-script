local function showInternal(code, ctx)
	ctx = ctx or {}
	if not ERR[code] then
		ctx.detail = tostring(ctx.detail or "") .. "\n(unknown code " .. tostring(code) .. ")"
		code = "E18"
	end
	local def = ERR[code]
	local W, H = SIZES[def.tpl][1], SIZES[def.tpl][2]

	while Errors.Showing do
		task.wait(0.1)
	end
	Errors.Showing = true

	local s = Errors.Session
	local fresh = not (s and s.gui and s.gui.Parent)
	if fresh then
		s = openSession()
		Errors.Session = s
	end
	s.boxGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, def.color), ColorSequenceKeypoint.new(0.5, C.accent2), ColorSequenceKeypoint.new(1, def.color),
	})
	s.spGrad.Color = ColorSequence.new(def.color)
	if s.content then
		s.content:Destroy()
		s.content = nil
		if s.contentUnsub then
			s.contentUnsub()
			s.contentUnsub = nil
		end
	end

	if fresh then
		-- 1) mini kare
		tween(s.pop, 0.35, {Scale = 1}, Ease.Back)
		tween(s.box, 0.25, {BackgroundTransparency = 0})
		task.wait(0.55)
		-- 2) çubuk (Loading)
		goBar(s)
		task.wait(0.9)
	else
		task.wait(0.5)
	end
	-- 3) büyük kare (Loading)
	goBig(s, W, H)
	task.wait(1.0)

	-- 4) hata menüsü
	local result = Instance.new("BindableEvent")
	local fired = false
	local function finish(action)
		if fired then
			return
		end
		fired = true
		result:Fire(action)
	end
	local content, unsub = buildContent(s, code, def, ctx, W, H, finish)
	s.content, s.contentUnsub = content, unsub
	tween(s.loading, 0.25, {GroupTransparency = 1})
	tween(content, 0.3, {GroupTransparency = 0})
	Errors.Showing = false

	local action = result.Event:Wait()
	result:Destroy()

	if action == "retry" then
		-- Yerinde "Yükleniyor" durumuna dön; çağıran Close() veya Show() çağırır
		tween(content, 0.2, {GroupTransparency = 1})
		task.wait(0.2)
		content:Destroy()
		if s.contentUnsub then
			s.contentUnsub()
		end
		s.content, s.contentUnsub = nil, nil
		tween(s.loading, 0.2, {GroupTransparency = 0})
		goBar(s)
	else
		Errors.Session = nil
		collapse(s)
	end
	return action
end

-- Gösterir ve kullanıcı seçimini döndürür: "retry" | "key" | "close"
function Errors.Show(code, ctx)
	local ok, action = pcall(showInternal, code, ctx)
	if ok then
		return action
	end
	warn("[CR-SETA] hata menüsü açılamadı: " .. tostring(action))
	Errors.Showing = false
	local s = Errors.Session
	Errors.Session = nil
	if s and s.gui then
		pcall(function()
			s.gui:Destroy()
		end)
	end
	Windows.Restore()
	return "close"
end

-- "retry" sonrası açık kalan yükleniyor çubuğunu kapatır
function Errors.Close(restore)
	local s = Errors.Session
	if s then
		Errors.Session = nil
		collapse(s)
	end
	if restore then
		Windows.Restore()
	end
end

