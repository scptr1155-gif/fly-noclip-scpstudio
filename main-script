	local pack = UI[Lang.Code] or UI.EN
	return pack[key] or UI.EN[key] or key
end

function Lang.Subscribe(fn)
	local id = {}
	Lang.Subs[id] = fn
	return function()
		Lang.Subs[id] = nil
	end
end

function Lang.Set(code)
	if not UI[code] or Lang.Code == code then
		return
	end
	Lang.Code = code
	Shared.Language = code
	for _, fn in pairs(Lang.Subs) do
		pcall(fn)
	end
	if Shared.OnLanguage then
		pcall(Shared.OnLanguage, code)
	end
end
Shared.SetLanguage = Lang.Set

