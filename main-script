-- Açık pencereleri kapatma / geri getirme
local Windows = {hidden = {}}

function Windows.Hide()
	local list = Shared.Windows
	for i = #list, 1, -1 do
		local g = list[i]
		if typeof(g) ~= "Instance" or not g.Parent then
			table.remove(list, i)
		elseif g.Enabled then
			Windows.hidden[#Windows.hidden + 1] = g
			g.Enabled = false
		end
	end
	local toast = PlayerGui:FindFirstChild("crseta_toast")
	if toast then
		toast:Destroy()
	end
end

function Windows.Restore()
	for _, g in ipairs(Windows.hidden) do
		if g.Parent then
			g.Enabled = true
		end
	end
	Windows.hidden = {}
end

local Errors = {Session = nil, Showing = false}

local function dotColor(state)
	if state == "ok" or state == "yes" then
		return C.green
	elseif state == "fail" or state == "no" then
		return C.red
	end
	return C.muted
end

