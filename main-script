    }, gui)
    UI.corner(card, 16)
    UI.gradient(card, Color3.fromRGB(24, 24, 40), Color3.fromRGB(12, 12, 20), 90)
    local stroke = UI.new("UIStroke", {Thickness = 1.5, Color = Color3.new(1, 1, 1)}, card)
    UI.gradient(stroke, UI.ACCENT1, UI.ACCENT2, 45)
    local scale = UI.new("UIScale", {Scale = 0.8}, card)
    UI.tween(scale, 0.35, {Scale = 1}, Enum.EasingStyle.Back)

    -- Başlık
    local header = UI.new("Frame", {Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1}, card)
    UI.drag(header, card, conns)

    local logo = UI.new("TextLabel", {
        Position = UDim2.new(0, 0, 0, 8), Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1, Text = "cr-game", Font = Enum.Font.GothamBlack,
        TextSize = 32, TextColor3 = Color3.new(1, 1, 1),
    }, header)
    UI.gradient(logo, UI.ACCENT1, UI.ACCENT2, 0)

    local sub = UI.new("TextLabel", {
        Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 11,
        TextColor3 = Color3.fromRGB(150, 150, 175),
    }, header)

    local closeBtn = UI.new("TextButton", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.new(0, 26, 0, 26),
        BackgroundColor3 = UI.PANEL2, Text = "X", Font = Enum.Font.GothamBold, TextSize = 12,
        TextColor3 = Color3.fromRGB(220, 220, 230), AutoButtonColor = true,
    }, header)
    UI.corner(closeBtn, 8)
    closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

    local pages = UI.new("Frame", {Position = UDim2.new(0, 0, 0, 76), Size = UDim2.new(1, 0, 1, -76), BackgroundTransparency = 1}, card)

    ----------------------------------------------------------------
    -- Sayfa 1: Dil seçimi
    ----------------------------------------------------------------
    local langPage = UI.new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1}, pages)
    local pickLabel = UI.new("TextLabel", {
        Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = Color3.fromRGB(210, 210, 225),
        Text = "Select your language / Dilini seç",
    }, langPage)
    local enBtn = UI.button(langPage, "English", UDim2.new(0.5, -140, 0, 36), UDim2.new(0, 280, 0, 56), UI.ACCENT1, UI.ACCENT2)
    local trBtn = UI.button(langPage, "Türkçe", UDim2.new(0.5, -140, 0, 106), UDim2.new(0, 280, 0, 56), UI.ACCENT2, UI.ACCENT1)
    enBtn.TextSize = 18
    trBtn.TextSize = 18

    ----------------------------------------------------------------
    -- Sayfa 2: Key
    ----------------------------------------------------------------
    local keyPage = UI.new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false}, pages)
    local titleLabel = UI.new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
        TextSize = 14, TextColor3 = Color3.fromRGB(210, 210, 225),
    }, keyPage)

    local box = UI.new("TextBox", {
        Position = UDim2.new(0.5, -140, 0, 28), Size = UDim2.new(0, 280, 0, 42),
        BackgroundColor3 = UI.PANEL, TextColor3 = Color3.new(1, 1, 1),
        PlaceholderColor3 = Color3.fromRGB(125, 125, 145), Font = Enum.Font.Gotham,
        TextSize = 14, ClearTextOnFocus = false, Text = "",
    }, keyPage)
    UI.corner(box, 10)
    local boxStroke = UI.new("UIStroke", {Thickness = 1.2, Color = Color3.fromRGB(70, 70, 95)}, box)
    box.Focused:Connect(function() UI.tween(boxStroke, 0.15, {Color = UI.ACCENT1}) end)
    box.FocusLost:Connect(function() UI.tween(boxStroke, 0.15, {Color = Color3.fromRGB(70, 70, 95)}) end)

    local getKeyBtn = UI.button(keyPage, "", UDim2.new(0.5, -140, 0, 80), UDim2.new(0, 280, 0, 38), UI.ACCENT1, UI.ACCENT2)
    local verifyBtn = UI.button(keyPage, "", UDim2.new(0.5, -140, 0, 124), UDim2.new(0, 280, 0, 38), UI.GREEN1, UI.GREEN2)

    local barBg = UI.new("Frame", {Position = UDim2.new(0.5, -140, 0, 172), Size = UDim2.new(0, 280, 0, 4), BackgroundColor3 = UI.PANEL2, BorderSizePixel = 0}, keyPage)
    UI.corner(barBg, 2)
    local bar = UI.new("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, barBg)
    UI.corner(bar, 2)
    UI.gradient(bar, UI.GREEN1, UI.ACCENT1, 0)

    local status = UI.new("TextLabel", {
        Position = UDim2.new(0, 10, 0, 182), Size = UDim2.new(1, -20, 0, 18), BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium, TextSize = 12, Text = "", TextColor3 = Color3.new(1, 1, 1),
    }, keyPage)

    local langBtn = UI.button(keyPage, "", UDim2.new(0.5, -60, 0, 208), UDim2.new(0, 120, 0, 28), UI.PANEL2, UI.PANEL)
    langBtn.TextSize = 12

    local function setStatus(msg, good)
        status.Text = msg
        status.TextColor3 = good and Color3.fromRGB(90, 230, 130) or Color3.fromRGB(255, 100, 100)
    end

    local function refreshTexts()
        local t = TEXT[curLang()]
        sub.Text = t.sub
        titleLabel.Text = t.title
        box.PlaceholderText = t.placeholder
        getKeyBtn.Text = t.getkey
        verifyBtn.Text = t.verify
        langBtn.Text = t.lang
    end

    local function setPage(p)
        langPage.Visible = (p == "lang")
        keyPage.Visible = (p == "key")
    end

    local function chooseLang(code)
        getgenv().CR_LANG = code
        cfg.lang = code
        saveCfg()
        refreshTexts()
        setPage("key")
    end
    enBtn.MouseButton1Click:Connect(function() chooseLang("EN") end)
    trBtn.MouseButton1Click:Connect(function() chooseLang("TR") end)

    langBtn.MouseButton1Click:Connect(function()
        chooseLang(curLang() == "TR" and "EN" or "TR")
        setStatus("", true)
    end)

    getKeyBtn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(GET_KEY_URL)
            setStatus(TEXT[curLang()].copied, true)
        else
            setStatus(getError("clipboard_unsupported"), false)
        end
    end)

    local busy = false
    verifyBtn.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true

        local input = (box.Text:gsub("%s+", ""))
        if input == "" then
            setStatus(getError("empty_key"), false)
            busy = false
            return
        end

        verifyBtn.Text = "..."
        local keys = fetchKeys()
        verifyBtn.Text = TEXT[curLang()].verify

        if not keys then
            setStatus(getError("code_load_failed"), false)
            busy = false
            return
        end
        if not keyExists(keys, input) then
            setStatus(getError("invalid_key"), false)
            busy = false
            return
        end

        cfg.key = input
        saveCfg()

        setStatus(TEXT[curLang()].success, true)
        UI.tween(bar, 0.8, {Size = UDim2.new(1, 0, 1, 0)})
        task.wait(0.9)
        gui:Destroy()
        launch()
    end)

    refreshTexts()
    if message then setStatus(message, false) end
    setPage(cfg.lang and "key" or "lang")
end

--------------------------------------------------------------------
-- Başlangıç
--------------------------------------------------------------------
loadCfg()
getgenv().CR_LANG = cfg.lang

if cfg.lang and cfg.key then
    local keys = fetchKeys()
    if not keys then
        openGate(getError("code_load_failed"))
    elseif keyExists(keys, cfg.key) then
        launch()
    else
        cfg.key = nil
        saveCfg()
        openGate(getError("key_removed"))
    end
else
    openGate()
end
