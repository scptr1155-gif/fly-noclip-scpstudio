				Hold[key] = input
				tween(button, 0.1, {BackgroundColor3 = COLORS.accent})
			end
		end)
		PadButtons[key] = button
	end

	padButton("▲", 0, "Up")
	padButton("▼", 64, "Down")
end

UIS.InputEnded:Connect(function(input)
	for key, held in pairs(Hold) do
		if held == input then
			Hold[key] = nil
			if PadButtons[key] then
				tween(PadButtons[key], 0.14, {BackgroundColor3 = COLORS.button})
			end
		end
	end
end)

