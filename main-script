local MyId = tostring(os.clock()) .. "-" .. tostring(math.random(1, 1000000000))
stateEnv()[K.K_INST] = MyId

local function stillMine()
	return stateEnv()[K.K_INST] == MyId
end

for _, name in ipairs({"crseta_key", "crseta_toast", "crseta_error"}) do
	local old = PlayerGui:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

local Valid, KeyExpiry, ForceGate, GateBusy = false, 0, false, false

local function writeState(ok, exp)
	Valid = ok
	KeyExpiry = exp
	local t = nowTime()
	stateEnv()[K.K_STATE] = {
		ok = ok, exp = exp, uid = Player.UserId, beat = t,
		sig = stateSig(ok, exp, Player.UserId, t),
	}
end

local function launchNormal()
	for attempt = 1, 3 do
		local ok, err = loadAndRun(SCRIPT_URL, "script")
		if ok then
			return true
		end
		warn("[CR-SETA] script yüklenemedi (" .. tostring(err) .. ") deneme " .. attempt)
		task.wait(1.5 * attempt)
	end
	return false
end

-- Kapıyı açar; doğrulanınca normal script'i başlatır
local function activate(message)
	if GateBusy then
		return
	end
	GateBusy = true
	task.spawn(function()
		local ok, err = pcall(function()
			while stillMine() do
				local exp = runKeyGate(message)
				writeState(true, exp)
				if launchNormal() then
					break
				end
				writeState(false, 0)
				message = kt("loadfail")
			end
		end)
		if not ok then
			warn("[CR-SETA] " .. tostring(err))
			writeState(false, 0)
		end
		GateBusy = false
	end)
end

-- Kalp atışı + süre kontrolü (normal script bunu izler)
writeState(false, 0)
task.spawn(function()
	while stillMine() do
		task.wait(5)
		local ok, err = pcall(function()
			if Valid and (nowTime() >= KeyExpiry or ForceGate) then
				ForceGate = false
				writeState(false, 0)
				activate(kt("ended"))
			else
				writeState(Valid, Valid and KeyExpiry or 0)
			end
		end)
		if not ok then
			warn("[CR-SETA] " .. tostring(err))
		end
	end
end)

-- Liste kontrolü: kod listeden silindiyse kilitler
task.spawn(function()
	while stillMine() do
		task.wait(KEY_RECHECK)
		if Valid then
			pcall(function()
				local keys = fetchKeys()
				if keys then
					local store = loadStore()
					if not store.last or not keys[store.last] then
						ForceGate = true
					end
				end
			end)
		end
	end
end)

-- Başlangıç: kayıtlı anahtar geçerliyse sessiz giriş, değilse kapı
task.spawn(function()
	local launched = false
	pcall(function()
		local store = loadStore()
		if store.last then
			local ok, a = verifyKey(store.last)
			if ok then
				writeState(true, a)
				keyToast(kt("ok") .. formatRemaining(a - nowTime()), COLORS.green)
				launched = launchNormal()
				if not launched then
					writeState(false, 0)
				end
			end
		end
	end)
	if not launched then
		activate()
	end
end)


