-- Tek istek: request -> http_request -> game:HttpGet
yerel fonksiyon rawGet(url)
	for _, name in ipairs({K.K_RQ1, K.K_RQ2}) do
		yerel fonksiyon = getGlobal(isim)
		if type(fn) == "function" then
			yerel tamam, res = pcall(fn, {Url = url, Method = "GET"})
			eğer uygunsa ve type(res) == "table" ise
				yerel kod = tonumber(res.StatusCode) veya (res.Success ve 200 veya nil)
				Eğer kod 200 ise ve tür (res.Body) "string" ise
					res.Body'yi döndür, 200
				son
				eğer kod o zaman
					nil döndür, kod
				son
			son
			eğer sorun yoksa ve type(res) == "string" ise ve #res > 0 ise
				return res, 200
			son
		son
	son
	yerel okFn, hg = pcall(fonksiyon()
		oyunu döndür[K.K_HG]
	son)
	eğer okFn ve type(hg) == "function" ise
		yerel tamam, res = pcall(function()
			return game[K.K_HG](game, url, true)
		son)
		eğer sorun yoksa ve type(res) == "string" ise ve #res > 0 ise
			return res, 200
		son
		Eğer uygunsa o zaman
			yerel mesaj = tostring(res)
			nil döndür, tonumber(msg:match("HTTP (%d%d%d)")) veya 0
		son
	son
	nil döndür, 0
son

-- Zaman aşımı: istek thread'te çalışır, ana thread beklemez
yerel fonksiyon httpGet(url, zaman aşımı)
	yerel tamamlandı, gövde, durum = yanlış, boş, boş
	görev.oluştur(fonksiyon()
		yerel b, s = rawGet(url)
		vücut, durum = b, s
		tamamlandı = doğru
	son)
	yerel son tarih = mono() + (zaman aşımı veya CFG.HttpTimeout)
	while not done and mono() < deadline do
		görev.bekle(0.05)
	son
	yapılmadıysa o zaman
		nil döndür, 0, "zaman aşımı"
	son
	dönüş gövdesi, durum
son

yerel fonksiyon httpCapable()
	if type(getGlobal(K.K_RQ1)) == "function" or type(getGlobal(K.K_RQ2)) == "function" then
		true döndür
	son
	yerel tamam, fn = pcall(fonksiyon()
		oyunu döndür[K.K_HG]
	son)
	ok döndür ve type(fn) == "function"
son

yerel fonksiyon loadstringCapable()
