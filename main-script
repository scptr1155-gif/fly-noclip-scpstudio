local function tween(object, duration, props, style, direction)
	local info = TweenInfo.new(duration, style or Ease.Quad, direction or EaseDir.Out)
	local t = TweenService:Create(object, info, props)
	t:Play()
	return t
end

local function corner(object, radius)
	return new(S.CORNER, {CornerRadius = UDim.new(0, radius)}, object)
end

local function stroke(object, color, thickness, transparency)
	return new(S.STROKE, {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
	}, object)
end

local function isPointer(input)
	return input.UserInputType == UserInputType.MouseButton1 or input.UserInputType == UserInputType.Touch
end

-- hover + basma animasyonu (metni kapatmayan temiz yöntem)
local function fx(button, radius, hoverColor)
	local baseColor = button.BackgroundColor3
	local hasStroke = button:FindFirstChildOfClass(S.STROKE)
	local scale = new(S.SCALE, {}, button)

	button.MouseEnter:Connect(function()
		if hoverColor then
			tween(button, 0.18, {BackgroundColor3 = hoverColor})
		end
		if hasStroke then
			tween(hasStroke, 0.18, {Transparency = 0.25})
		end
	end)
	button.MouseLeave:Connect(function()
		tween(button, 0.22, {BackgroundColor3 = baseColor})
		if hasStroke then
			tween(hasStroke, 0.22, {Transparency = 0.7})
		end
		tween(scale, 0.12, {Scale = 1})
	end)
	button.MouseButton1Down:Connect(function()
		tween(scale, 0.08, {Scale = 0.97})
	end)
	button.MouseButton1Up:Connect(function()
		tween(scale, 0.18, {Scale = 1}, Ease.Back)
	end)

	return scale
end

-- sürükleme takibi (global dinleyici yalnızca sürükleme sırasında açık)
local function trackDrag(handle, onBegin, onMove)
	handle.InputBegan:Connect(function(input)
		if not isPointer(input) then
			return
		end

		local moveConn, endConn
		local function stop()
			if moveConn then
				moveConn:Disconnect()
				moveConn = nil
			end
			if endConn then
				endConn:Disconnect()
				endConn = nil
			end
		end

		if onBegin(input) == false then
			return
		end
		moveConn = UIS.InputChanged:Connect(function(changed)
			if changed.UserInputType == UserInputType.MouseMovement or changed == input then
				onMove(changed)
			end
		end)
		endConn = UIS.InputEnded:Connect(function(changed)
			if changed == input or changed.UserInputState == UserInputState.End then
				stop()
			end
		end)
	end)
end


