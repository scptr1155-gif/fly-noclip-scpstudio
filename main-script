			tween(card, 0.05, {Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset)})
			görev.bekle(0.05)
		son
		tween(boxStroke, 0.4, {Color = C.button})
	son

	yerel fonksiyon submit()
		meşgul ise o zaman
			geri dönmek
		son
		yerel şimdi = mono()
		eğer şimdi < kilitliyse o zamana kadar
			setStatus("wait", C.red, math.ceil(lockedUntil - now) .. T("secs"))
			geri dönmek
		son
		meşgul = doğru
		setStatus("checking", C.muted)
		yerel metin = kutu.Metin

		yerel ok, a, b = verifyKey(metin)
		Eğer uygunsa o zaman
			yerel son kullanma tarihi, kod = a, b
			kutuÇizgisi.Renk = C.yeşil
			setStatus("tamam", C.green, formatRemaining(son kullanma tarihi - nowTime()))
			görev.bekle(0.6)
			tween(cardScale, 0.25, {Scale = 0.85}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			görev.bekle(0.2)
			aboneliği kaldır()
			ui:Yok Et()
			keyToast(T("ok") .. formatRemaining(expiry - nowTime()), C.green)
			sonuç: Ateşle (son kullanma tarihi, kod)
			geri dönmek
		son

		meşgul = yanlış
		yerel sebep, detay = a, b
		eğer sebep "net" ise o zaman
			setStatus("netError", C.red)
			sallamak()
		aksi takdirde eğer sebep "anahtar" ise o zaman
			setStatus("keyError", C.red)
			sallamak()
		aksi takdirde sebep "boş" ise
			setStatus("empty", C.red)
		başka
			başarısızlıklar = başarısızlıklar + 1
			Eğer başarısız deneme sayısı CFG.WrongTries'den büyük veya eşitse, o zaman
				başarısızlıklar = 0
				lockedUntil = mono() + CFG.LockSeconds
			son
			setStatus("geçersiz", C.red)
			tween(boxStroke, 0.15, {Color = C.red})
			sallamak()
		son
		eğer statusKey == "checking" ise
			durumAnahtarı = nil
			durum.Metin = ""
		son
	son

	enterBtn.Activated:Connect(submit)
	kutu.OdakKaybı:Bağlan(fonksiyon(enterPressed)
		Enter tuşuna basılırsa
			göndermek()
		son
	son)
	getBtn.Activated:Connect(function()
		Eğer copyText(K.K_URL) varsa, o zaman
			setStatus("copyed", C.green)
		başka
			linkBox.Visible = true
			setStatus("manual", C.muted)
			pcall(fonksiyon()
				linkBox:CaptureFocus()
			son)
		son
	son)

	yerel süre sonu, kod = sonuç.Olay:Bekle()
	iade süresi, kod
son

