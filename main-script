	local s = {unsubs = {}}
	s.gui = new("ScreenGui", {Name = "crseta_error", ResetOnSpawn = false, DisplayOrder = 300, IgnoreGuiInset = true}, PlayerGui)
	new("TextButton", {Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true}, s.gui)
