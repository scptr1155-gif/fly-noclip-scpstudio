local Net = {}

local function rawGet(url)
	local status, lastErr
	for _, name in ipairs({K.K_RQ1, K.K_RQ2}) do
		local fn = getGlobal(name)
		if type(fn) == "function" then
			local ok, res = pcall(fn, {Url = url, Method = "GET"})
			if ok and type(res) == "table" then
				local code = tonumber(res.StatusCode) or (res.Success and 200 or nil)
				if code == 200 and type(res.Body) == "string" then
					return res.Body, 200
				end
				if code then
					return nil, code, tostring(res.StatusMessage or ""), res.Headers
				end
			else
				lastErr = tostring(res)
			end
		end
	end
	local okFn, hg = pcall(function()
		return game[K.K_HG]
	end)
	if okFn and type(hg) == "function" then
		local ok, res = pcall(function()
			return game[K.K_HG](game, url, true)
		end)
		if ok and type(res) == "string" then
			return res, 200
		end
		local msg = tostring(res)
		return nil, tonumber(msg:match("HTTP (%d%d%d)")) or tonumber(msg:match("(%d%d%d)")), msg
	end
	return nil, status, lastErr
end

-- Takılan isteği beklemeden zaman aşımına çevirir (sistemi dondurmaz)
local function withTimeout(seconds, fn, ...)
	local done, r1, r2, r3, r4 = false
	local args = table.pack(...)
	task.spawn(function()
		local ok, a, b, c, d = pcall(fn, table.unpack(args, 1, args.n))
		if ok then
			r1, r2, r3, r4 = a, b, c, d
		else
			r1, r2, r3 = nil, nil, tostring(a)
		end
		done = true
	end)
	local deadline = os.clock() + seconds
	while not done and os.clock() < deadline do
		task.wait(0.05)
	end
	if not done then
		return nil, "timeout"
	end
	return r1, r2, r3, r4
end

function Net.fetch(url, timeout)
	local body, status, err, headers = withTimeout(timeout or 10, rawGet, url)
	if status == "timeout" then
		return nil, 0, "timeout"
	end
	return body, status, err, headers
end

function Net.classify(status, err)
	status = tonumber(status)
	if status == 404 or status == 410 then
		return "E05"
	end
	if status == 429 then
		return "E04"
	end
	if status and (status == 403 or status >= 500) then
		return "E06"
	end
	return "E03"
end

function Net.retryAfter(headers)
	if type(headers) ~= "table" then
		return nil
	end
	return tonumber(headers["Retry-After"] or headers["retry-after"])
end

function Net.caps()
	local caps = {}
	caps.http = type(getGlobal(K.K_RQ1)) == "function" or type(getGlobal(K.K_RQ2)) == "function"
	if not caps.http then
		local ok, fn = pcall(function()
			return game[K.K_HG]
		end)
		caps.http = ok and type(fn) == "function"
	end
	local ok, fn = pcall(loadstring, "return 1")
	caps.loadstring = ok and type(fn) == "function"
	caps.clipboard = type(getGlobal("setclipboard")) == "function" or type(getGlobal("toclipboard")) == "function"
	caps.files = type(getGlobal(K.K_WF)) == "function" and type(getGlobal(K.K_RF)) == "function"
		and type(getGlobal(K.K_IF)) == "function"
	return caps
end

