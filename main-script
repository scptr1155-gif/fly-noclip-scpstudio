local Keys = {lastBody = nil, lastKeys = nil, retryAfter = nil}

-- Anahtar listesi: tablo | nil, hataKodu, ayrıntı
-- · ?t= değeri 5 saniyelik dilimlere bölünür: aynı dilimdeki herkes aynı önbelleği paylaşır,
--   sunucuya binen yük azalır ama liste en fazla ~5 sn eski kalır
-- · Gövde öncekiyle aynıysa yeniden ayrıştırılmaz (CPU harcamaz)
function Keys.fetch()
	local bucket = math.floor(nowTime() / 5)
	local body, status, err, headers = Net.fetch(K.K_RAW .. "?t=" .. bucket, CFG.FetchTimeout)
	if not body then
		Keys.retryAfter = Net.retryAfter(headers)
		return nil, Net.classify(status, err), string.format("GET key list -> status=%s err=%s", tostring(status), tostring(err))
	end
	Keys.retryAfter = nil
	if body == Keys.lastBody and Keys.lastKeys then
		return Keys.lastKeys
	end
	local keys, count = {}, 0
	for line in body:gmatch("[^\r\n]+") do
		local code = normalizeKey(line)
		if code ~= "" and code:sub(1, 1) ~= "#" then
			keys[code] = true
			count += 1
		end
	end
	local head = body:sub(1, 200):lower()
	if count == 0 or head:find("<html", 1, true) or head:find("<!doctype", 1, true) then
		return nil, "E11", string.format("key list invalid: %d keys, %d bytes", count, #body)
	end
	Keys.lastBody, Keys.lastKeys = body, keys
	return keys
end

-- Yerel kayıt: her kodun ilk kullanım zamanı (MAC ile korunur)
local MemoryStore = {}

local function loadStore()
	local store = {started = {}, last = nil}
	local raw = MemoryStore.raw
	local isfile, readfile = getGlobal(K.K_IF), getGlobal(K.K_RF)
	if type(isfile) == "function" and type(readfile) == "function" then
		local ok, data = pcall(function()
			if isfile(K.K_FILE) then
				return readfile(K.K_FILE)
			end
		end)
		if ok and type(data) == "string" then
			raw = data
		end
	end
	for line in tostring(raw or ""):gmatch("[^\r\n]+") do
		local kind, a, b, c = line:match("^(%a)|([^|]*)|([^|]*)|?([^|]*)$")
		if kind == "K" and mac("K", a, b) == c then
			store.started[a] = tonumber(b)
		elseif kind == "L" and mac("L", a) == b then
			store.last = a
		end
	end
	return store
end

local function saveStore(store)
	local lines = {}
	for id, started in pairs(store.started) do
		table.insert(lines, string.format("K|%s|%s|%s", id, tostring(started), mac("K", id, tostring(started))))
	end
	if store.last then
		table.insert(lines, string.format("L|%s|%s", store.last, mac("L", store.last)))
	end
	local data = table.concat(lines, "\n")
	MemoryStore.raw = data
	local writefile = getGlobal(K.K_WF)
	if type(writefile) == "function" then
		pcall(writefile, K.K_FILE, data)
	end
end

-- Doğrulama: true, bitişZamanı, kod | false, sebep, ayrıntı
-- sebep: "empty" | "invalid" (satır içi mesaj) ya da E.. hata kodu (menü)
local function verifyKey(input, keysOverride)
	local code = normalizeKey(input)
	if code == "" then
		return false, "empty"
	end
	local keys, errCode, detail = keysOverride, nil, nil
	if not keys then
		keys, errCode, detail = Keys.fetch()
	end
	if not keys then
		return false, errCode, detail
	end
	if not keys[code] then
		return false, "invalid"
	end

	local store = loadStore()
	local id = khash(code)
	local t = nowTime()
	local started = store.started[id]
	if not started then
		started = t
		store.started[id] = started
	end
	if t >= started + CFG.KeyLifetime then
		return false, "E13", "key lifetime ended"
	end
	store.last = code
	saveStore(store)
	return true, started + CFG.KeyLifetime, code
end

