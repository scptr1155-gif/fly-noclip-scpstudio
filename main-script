-- 5) Key listeleri: önbellek + tek seferlik ayrıştırma + aynı anda tek indirme
--------------------------------------------------------------------
local lists = {
    user  = {url = URL_KEY,   set = nil, count = 0, at = 0, busy = false},
    admin = {url = URL_ADMIN, set = nil, count = 0, at = 0, busy = false},
}

-- Dosyayı bir kez okuyup { key = true } tablosuna çevirir. Büyük listede kareleri dondurmaz.
-- "KEY|tarih" gibi eski satırlarda sadece key kısmını alır.
local function parseList(text)
    local set, count, n = {}, 0, 0
    for line in text:gmatch("[^\r\n]+") do
        local clean = (line:gsub("%s+", ""))
        local key = clean:match("^([^|]+)")
        if key then
            set[key] = true
            count = count + 1
        end
        n = n + 1
        if n % SETTINGS.PARSE_CHUNK == 0 then task.wait() end
    end
    return set, count
end

-- Listeyi önbellekten ya da GitHub'dan alır. Başarısızsa nil döner.
local function getList(name, maxAge)
    local L = lists[name]

    -- 1) Önbellek taze mi?
    if L.set and (os.clock() - L.at) < maxAge then return L end

    -- 2) Aynı liste şu an başka bir yerde indiriliyorsa ikinci istek açma, bitmesini bekle
    if L.busy then
        local t0 = os.clock()
        while L.busy and (os.clock() - t0) < SETTINGS.HTTP_TIMEOUT do task.wait(0.1) end
        if not L.busy and L.set and (os.clock() - L.at) < maxAge then return L end
        return nil
    end

    -- 3) İndir + ayrıştır
    L.busy = true
    local result = nil
    local okFetch, text = pcall(fetchFile, L.url)
    if okFetch and text then
        local okParse, set, count = pcall(parseList, text)
        if okParse then
            L.set, L.count, L.at = set, count, os.clock()
            result = L
        else
            lastFetchError = "parse error"
        end
    elseif not okFetch then
        lastFetchError = tostring(text)
    end
    L.busy = false
    return result
end

-- "admin" / "user" / "error" (liste okunamadı) / nil (key hiçbir listede yok)
-- hint: bilinen rol. Önce o liste kontrol edilir, key orada bulunursa ikinci istek hiç atılmaz.
local function lookupKey(input, hint, maxAge)
    local order = (hint == "user") and {"user", "admin"} or {"admin", "user"}
    local failed, anyKeys = false, false

    for _, name in ipairs(order) do
        local L = getList(name, maxAge)
        if not L then
            failed = true
        else
            if L.count > 0 then anyKeys = true end
            if L.set[input] then return name end
        end
    end

    if failed then return "error" end
    if not anyKeys then
        lastFetchError = "empty file"
        warn("[cr-game] key files are empty")
        return "error"
    end
    return nil
end

