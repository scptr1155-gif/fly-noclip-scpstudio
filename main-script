			ui:Destroy()
			keyToast(kt("ok") .. formatRemaining(remaining), COLORS.green)
			result:Fire(a)
			return
		end
		if a ~= "net" and a ~= "empty" then
			fails += 1
			if fails >= 5 then
				fails = 0
				lockedUntil = os.clock() + 20
			end
		end
		setStatus(kt(a) or a, COLORS.red)
		tween(boxStroke, 0.15, {Color = COLORS.red})
		shake()
		busy = false
	end

	enterBtn.Activated:Connect(submit)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
	getBtn.Activated:Connect(function()
		if copyText(K.K_URL) then
			linkBox.Visible = false
			setStatus(kt("copied"), COLORS.green)
		else
			linkBox.Visible = true
			setStatus(kt("manual"), COLORS.muted)
			pcall(function()
				linkBox:CaptureFocus()
			end)
		end
	end)

	return result.Event:Wait()
end

