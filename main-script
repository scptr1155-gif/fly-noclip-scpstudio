local function setToggle(toggle, on)
	toggle.State.Text = on and tr("on") or tr("off")
	tween(toggle.State, 0.2, {TextColor3 = on and COLORS.green or COLORS.muted})
	tween(toggle.Track, 0.2, {BackgroundColor3 = on and COLORS.green or COLORS.panel})
	-- NOT: çerçevenin saydamlığı giriş animasyonuna bırakılır (aksi halde
	-- giriş sırasında satırın üstinde boş bir çerçeve asılı kalır)
	tween(toggle.Stroke, 0.2, {Color = on and COLORS.green or COLORS.panel})
	tween(toggle.Chip, 0.2, {BackgroundColor3 = on and COLORS.green or COLORS.accent})
	tween(toggle.Knob, 0.28, {
		Position = on and UDim2.new(0, 21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
	}, Ease.Back)
	tween(toggle.Halo, 0.25, {
		Position = on and UDim2.new(1, 0, 0.5, 0) or UDim2.new(0, 0, 0.5, 0),
		BackgroundTransparency = on and 0.65 or 1,
	})
end

Refresh = function()
	Title.Text = tr("title")
	Subtitle.Text = tr("subtitle")
	FlyToggle.Label.Text = tr("fly")
	ClipToggle.Label.Text = tr("clip")
	SpeedLabel.Text = tr("speed")
	LanguageLabel.Text = tr("language")
	DiscordText.Text = tr("discord")
	DiscordHint.Text = tr("copy")
	Info.Text = infoText()

	setToggle(FlyToggle, State.Fly)
	setToggle(ClipToggle, State.NoClip)

	for code, button in pairs(LanguageButtons) do
		local active = code == State.Language
		fxBase[button] = active and COLORS.accent or COLORS.button
		tween(button, 0.22, {
			BackgroundColor3 = active and COLORS.accent or COLORS.button,
			TextColor3 = active and COLORS.text or COLORS.muted,
		})
	end

	if TouchPad and padShown ~= State.Fly then
		padShown = State.Fly
		if padShown then
			for _, button in pairs(PadButtons) do
				button.BackgroundColor3 = COLORS.button
			end
			TouchPad.Visible = true
			PadScale.Scale = 0.6
			tween(PadScale, 0.3, {Scale = 1}, Ease.Back)
		else
			TouchPad.Visible = false
		end
	end
end

FlyToggle.Row.Activated:Connect(function()
	if State.Fly then
		stopFly()
	else
		if not Root or not Humanoid or Humanoid.Health <= 0 then
			toast(tr("waitChar"), COLORS.red)
			return
		end
		if not startFly() then
			toast(tr("waitChar"), COLORS.red)
			return
		end
		toast(tr("fly") .. " · " .. tr("on"), COLORS.green)
	end
	Refresh()
end)

ClipToggle.Row.Activated:Connect(function()
	if State.NoClip then
		stopClip()
		toast(tr("clip") .. " · " .. tr("off"), COLORS.muted)
	else
		if not startClip() then
			toast(tr("waitChar"), COLORS.red)
			return
		end
		toast(tr("clip") .. " · " .. tr("on"), COLORS.green)
	end
	Refresh()
end)

