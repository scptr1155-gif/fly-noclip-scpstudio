local KEY = "MT_HYBRID_2026_X9"
local function enc(s,k)
    local t={}
    for i=1,#s do
        t[i]=bit32.bxor(string.byte(s,i),string.byte(k,(i-1)%#k+1))
    end
    return t
end

local function dec(t,k)
    local s={}
    for i,v in ipairs(t) do
        s[i]=string.char(bit32.bxor(v,string.byte(k,(i-1)%#k+1)))
    end
    return table.concat(s)
end

local function integrity()
    return type(enc)=="function"
        and type(dec)=="function"
        and #KEY==14
end

if not integrity() then return end

local CK="MT_COLOR"

local function color(r,g,b)
    return Color3.fromRGB(
        bit32.bxor(r,string.byte(CK,1)),
        bit32.bxor(g,string.byte(CK,2)),
        bit32.bxor(b,string.byte(CK,3))
    )
end

