-- GetMoveVector() yorum modu (çalışma anında kalibre edilir):
-- 1 = kamera-yerel ileri=-Z | 2 = kamera-yerel ileri=+Z | 3 = dünya-uzayı | 4 = eski düzen (X=ileri)
local MOVE_MODE = 2

task.spawn(function()
	local ok, module = pcall(function()
		return require(Player:WaitForChild(S.PLAYERSCRIPTS, 10):WaitForChild(S.PLAYERMODULE, 10))
	end)
	if ok and module then
		local ok2, controls = pcall(function()
			return module[S.GETCONTROLS](module)
		end)
		if ok2 and controls then
			Controls = controls
		end
	end
end)

local function new(class, props, parent)
	local object = Instance.new(class)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function stopFly()
	State.Fly = false

	if FlyConn then
		FlyConn:Disconnect()
		FlyConn = nil
	end

	for _, object in pairs(FlyParts) do
		if object and object.Parent then
			object:Destroy()
		end
	end
	FlyParts = {}
	table.clear(Hold)
	lastFacing = nil
	lastFlat = nil

	if Humanoid and Humanoid.Parent then
		Humanoid[S.PLATFORMSTAND] = false
		Humanoid[S.AUTOROTATE] = AutoRotateBackup
		if Humanoid.Health > 0 then
			pcall(function()
				Humanoid:ChangeState(Enum[S.ENUM_HSTATE].GettingUp)
			end)
		end
	end
end

-- Roblox'un GetMoveVector() eksen düzeni sürümden sürüme değişebiliyor.
-- Bu yüzden birkaç yorum adayı üretilir; dünya-uzayındaki gerçek referansla
-- (klavye veya Humanoid.MoveDirection) en tutarlı olan seçilir.
local function moveCandidates(cf, ctrl)
	return {
		cf:VectorToWorldSpace(Vector3.new(ctrl.X, 0, ctrl.Z)),   -- 1: kamera-yerel, ileri = -Z
		cf:VectorToWorldSpace(Vector3.new(ctrl.X, 0, -ctrl.Z)),  -- 2: kamera-yerel, ileri = +Z
		Vector3.new(ctrl.X, 0, ctrl.Z),                          -- 3: dünya-uzayı
		cf:VectorToWorldSpace(Vector3.new(ctrl.Z, 0, -ctrl.X)),  -- 4: eski düzen (X=ileri, Z=sağ)
	}
end

local function pickMoveMode(cf, ctrl, ref)
	local cands = moveCandidates(cf, ctrl)
	local refUnit = ref.Unit
	local best, bestIdx = nil, MOVE_MODE
	for i = 1, #cands do
		local cm = Vector3.new(cands[i].X, 0, cands[i].Z)
		if cm.Magnitude > 0.01 then
			local d = (cm.Unit - refUnit).Magnitude
			if best == nil or d < best then
				best, bestIdx = d, i
			end
		end
	end
	return bestIdx
end

-- UIS:IsKeyDown hata verirse uçuşu düşürmesin
local function keyDown(code)
	local ok, value = pcall(function()
		return UIS:IsKeyDown(code)
	end)
	return ok and value == true
end

local function startFly()
	if State.Fly or not Root or not Humanoid or Humanoid.Health <= 0 then
		return false
	end
	State.Fly = true

	local attachment = new(S.ATTACH, {}, Root)
	local linear = new(S.LINVEL, {
		Attachment0 = attachment,
		VelocityConstraintMode = Enum[S.ENUM_VCM].Vector,
		RelativeTo = Enum[S.ENUM_ACT].World,
		MaxForce = 1e7,
		VectorVelocity = Vector3.zero,
	}, Root)
	local align = new(S.ALIGNORI, {
		Mode = Enum[S.ENUM_ALIGN].OneAttachment,
		Attachment0 = attachment,
		RigidityEnabled = false,
		MaxTorque = 1e7,
		MaxAngularVelocity = 100,
		Responsiveness = 40,
		CFrame = Root.CFrame,
	}, Root)
	FlyParts = {attachment, linear, align}

	AutoRotateBackup = Humanoid[S.AUTOROTATE]
	Humanoid[S.AUTOROTATE] = false
	Humanoid[S.PLATFORMSTAND] = true

	local velocity = Vector3.zero

	FlyConn = RunService[S.HEARTBEAT]:Connect(function(dt)
		if not Root or not Root.Parent or not Humanoid or Humanoid.Health <= 0 then
			stopFly()
			if Refresh then
				Refresh()
			end
			return
		end

		local camera = workspace.CurrentCamera
		if not camera then
			return
		end

		local cf = camera.CFrame
		local typing = UIS[S.GETFOCUSEDTEXTBOX](UIS) ~= nil

		-- klavye girdisi (iç düzlem: X = sağ, Z = +ileri)
		local kb = Vector3.zero
		if not typing then
			kb = Vector3.new(
				(keyDown(KeyCode.D) and 1 or 0) - (keyDown(KeyCode.A) and 1 or 0),
				0,
				(keyDown(KeyCode.W) and 1 or 0) - (keyDown(KeyCode.S) and 1 or 0)
			)
		end

		-- joystick / gamepad girdisi (eksen düzeni sürüme göre değişebiliyor)
		local ctrl = nil
		if Controls and not typing then
			local ok, v = pcall(function()
				return Controls[S.GETMOVEVECTOR](Controls)
			end)
			if ok and type(v) == "Vector3" and v.Magnitude > 0.01 then
				ctrl = Vector3.new(v.X, 0, v.Z)
			end
		end

		local vertical = 0
		if Hold.Up then
			vertical = vertical + 1
		end
		if Hold.Down then
			vertical = vertical - 1
		end
		if not typing then
			if UIS:IsKeyDown(KeyCode.Space) then
				vertical = vertical + 1
			end
			if UIS:IsKeyDown(KeyCode.LeftControl) or UIS:IsKeyDown(KeyCode.RightControl) then
				vertical = vertical - 1
			end
		end

		-- yatay kamera eksenleri (kamera eğimi hesaba katılmaz)
		local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if flat.Magnitude < 0.01 then
			flat = lastFlat or Vector3.new(0, 0, -1)
		else
			flat = flat.Unit
			lastFlat = flat
		end
		local rightFlat = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
		if rightFlat.Magnitude < 0.01 then
			rightFlat = Vector3.new(-flat.Z, 0, flat.X)
		else
			rightFlat = rightFlat.Unit
		end

		-- yön hesabı: her şey DÜNYA-UZAYINA çevrilir.
		-- klavye belirleyicidir; joystick/gamepad kalibre edilmiş yorumla kullanılır.
		local dir = Vector3.zero

		if kb.Magnitude > 0.01 then
			-- W/S: kameranın TAM bakış yönü (yukarı/aşağı eğim dahil), A/D: yatay yan hareket
			dir = cf.LookVector * kb.Z + rightFlat * kb.X
			-- kontrol modülü de aktifse yorum modunu kalibre et (referans yatay kalmalı)
			if ctrl then
				MOVE_MODE = pickMoveMode(cf, ctrl, flat * kb.Z + rightFlat * kb.X)
			end
		elseif ctrl then
			local cands = moveCandidates(cf, ctrl)
			-- referans: Humanoid.MoveDirection (dünya-uzayı, tüm cihazlar)
			local ref = Vector3.zero
			if Humanoid then
				local md = Humanoid.MoveDirection
				if md and md.Magnitude > 0.01 then
					ref = Vector3.new(md.X, 0, md.Z)
				end
			end
			if ref.Magnitude > 0.01 then
				MOVE_MODE = pickMoveMode(cf, ctrl, ref)
			end
			dir = cands[MOVE_MODE]
		end

		local direction = dir + Vector3.yAxis * math.clamp(vertical, -1, 1)
		if direction.Magnitude > 1 then
			direction = direction.Unit
		end

		velocity = velocity:Lerp(direction * CONFIG.Speed, math.min(1, dt * 12))
		linear[S.VECTORVELOCITY] = velocity

		-- karakter kameraya baksın (yalnızca yön değiştiğinde güncelle)
		if lastFacing ~= flat then
			lastFacing = flat
			align[S.CFRAME] = CFrame.lookAt(Vector3.zero, flat)
		end
	end)

	return true
end

local function trackPart(part)
	if part:IsA(S.BASEPART) and ClipParts[part] == nil then
		ClipParts[part] = part[S.CANCOLLIDE]
	end
end

local function stopClip()
