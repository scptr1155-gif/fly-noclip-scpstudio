-- Roblox'ta pano yazma API'si yok; global fonksiyon varsa (exploit/command bar) onu dener
local function globalFn(name)
	local env = (type(getfenv) == "function") and getfenv(0) or _G
	if type(env) == "table" then
		local fn = rawget(env, name)
		if type(fn) == "function" then
			return fn
		end
	end
	return nil
end

-- kopyalama: önce native/global yol, yoksa odaklı metin kutusu
local function copyInvite()
	local text = S.INVITE

	local setter = globalFn(S.SETCLIPBOARD) or globalFn(S.TOCLIPBOARD)
	if setter then
		local ok = pcall(setter, text)
		if ok then
			return true
		end
	end

	-- Roblox'ta yazma API'si yok: metni seçili metin kutusunda göster
	DiscordBox.Text = text
	DiscordBox.Visible = true
	DiscordBox.TextEditable = true
	DiscordBox.Selectable = true
	DiscordButton.Visible = false
	Info.Text = tr("manual")
	pcall(function()
		DiscordBox:CaptureFocus()
		DiscordBox.CursorPosition = #text
		DiscordBox.SelectionStart = 1
	end)
	return false
end

