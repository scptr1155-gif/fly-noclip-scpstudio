-- 0) Şifre çözücü (XOR + checksum)
--------------------------------------------------------------------
local MK = {179, 92, 37, 240, 128, 65, 13, 201, 76, 158, 222, 41, 97, 190, 250, 84, 33, 145, 118, 60}

local function bxor(a, b)
	if bit32 then
		return bit32.bxor(a, b)
	end
	local result, place = 0, 1
	while a > 0 or b > 0 do
		local x, y = a % 2, b % 2
		if x ~= y then
			result = result + place
		end
		a = (a - x) / 2
		b = (b - y) / 2
		place = place * 2
	end
	return result
end

local function decode(chunk)
	local salt, check = chunk[1], chunk[2]
	local buffer, sum = {}, 0
	for i = 1, #chunk - 2 do
		local key = MK[((i + salt) % #MK) + 1]
		local byte = (chunk[i + 2] - salt - i * 11) % 256
		local plain = bxor(byte, key)
		buffer[i] = string.char(plain)
		sum = (sum + plain) % 256
	end
	if sum ~= check then
		error("CR-SETA: cipher integrity check failed", 0)
	end
	return table.concat(buffer)
end

