-- sürükleme (ekran içinde kalacak şekilde)
local dragStart, startPosition

-- üst bar butonları basılıyken pencere sürüklenmesin
local uiPressed = false
local function markPressed(object)
	object.InputBegan:Connect(function()
		uiPressed = true
	end)
	object.InputEnded:Connect(function()
		uiPressed = false
	end)
end
markPressed(Minimize)
markPressed(Close)

local function clampPosition(pos)
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local size = Main.AbsoluteSize
	local half = size * 0.5
	local x = math.clamp(pos.X.Offset, half.X - viewport.X * pos.X.Scale + 8, viewport.X * (1 - pos.X.Scale) - half.X - 8)
	local y = math.clamp(pos.Y.Offset, half.Y - viewport.Y * pos.Y.Scale + 8, viewport.Y * (1 - pos.Y.Scale) - half.Y - 8)
	return UDim2.new(pos.X.Scale, x, pos.Y.Scale, y)
end

trackDrag(TopBar, function(input)
	if uiPressed then
		return false
	end
	dragStart = input.Position
	startPosition = Main.Position
end, function(changed)
	local delta = changed.Position - dragStart
	Main.Position = clampPosition(UDim2.new(
		startPosition.X.Scale, startPosition.X.Offset + delta.X,
		startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
	))
end)

