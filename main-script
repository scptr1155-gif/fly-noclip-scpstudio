			ColorSequenceKeypoint.new(0, C.accent), ColorSequenceKeypoint.new(0.5, C.accent2), ColorSequenceKeypoint.new(1, C.accent),
		}),
	}, cardStroke)
	TweenService:Create(cardGradient, TweenInfo.new(4, Ease.Linear, EaseDir.In, -1), {Rotation = 360}):Play()
	local cardScale = new("UIScale", {Scale = 0.85}, card)

	local title = new("TextLabel", {
		Position = UDim2.fromOffset(20, 16), Size = UDim2.new(1, -40, 0, 26), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, TextSize = 21, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	local sub = new("TextLabel", {
		Position = UDim2.fromOffset(20, 44), Size = UDim2.new(1, -40, 0, 16), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.muted, TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	local box = new("TextBox", {
		Position = UDim2.fromOffset(20, 76), Size = UDim2.new(1, -40, 0, 44), BackgroundColor3 = C.panel,
		Font = Enum.Font.GothamSemibold, TextSize = 15, TextColor3 = C.text, PlaceholderColor3 = C.muted,
		Text = "", ClearTextOnFocus = false,
	}, card)
	corner(box, 11)
	local boxStroke = stroke(box, C.button, 1.4, 0)

	local enterBtn = new("TextButton", {
		Position = UDim2.fromOffset(20, 134), Size = UDim2.new(0.5, -26, 0, 42), BackgroundColor3 = C.accent,
		AutoButtonColor = false, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = C.text,
	}, card)
	corner(enterBtn, 11)
	fx(enterBtn, 11, Color3.fromRGB(40, 185, 255))
	local getBtn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 134), Size = UDim2.new(0.5, -26, 0, 42),
		BackgroundColor3 = C.discord, AutoButtonColor = false, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = C.text,
	}, card)
	corner(getBtn, 11)
	fx(getBtn, 11, C.discordHover)

	local linkBox = new("TextBox", {
		Position = UDim2.fromOffset(20, 186), Size = UDim2.new(1, -40, 0, 30), BackgroundColor3 = C.panel,
		Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.text, Text = K.K_URL, TextEditable = false,
		ClearTextOnFocus = false, Visible = false,
	}, card)
	corner(linkBox, 8)
	local status = new("TextLabel", {
		Position = UDim2.fromOffset(20, 222), Size = UDim2.new(1, -40, 0, 30), BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold, TextSize = 12, TextColor3 = C.muted, TextWrapped = true, Text = message or "",
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	}, card)
	langBar(card, UDim2.fromOffset(20, 260))

	-- Satır içi mesaj: dil değişince yeniden çevrilebilsin diye anahtar olarak tutulur
	local statusKey, statusExtra, statusColor
	local function setStatus(key, color, extra)
		statusKey, statusColor, statusExtra = key, color or C.muted, extra or ""
		status.Text = T(key) .. statusExtra
		status.TextColor3 = statusColor
	end
	local function applyTexts()
		title.Text, sub.Text = T("title"), T("sub")
		box.PlaceholderText = T("placeholder")
		enterBtn.Text, getBtn.Text = T("enter"), T("get")
		if statusKey then
			status.Text = T(statusKey) .. statusExtra
		end
	end
	applyTexts()
	local unsub = Lang.Subscribe(applyTexts)
	tween(cardScale, 0.4, {Scale = 1}, Ease.Back)
	tween(card, 0.4, {Position = UDim2.new(0.5, 0, 0.5, 0)}, Ease.Quint)

	local result = Instance.new("BindableEvent")
	local busy, fails, lockedUntil = false, 0, 0

	local function shake()
		local base = card.Position
		for _, dx in ipairs({-8, 8, -5, 5, 0}) do
			tween(card, 0.05, {Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset)})
			task.wait(0.05)
		end
		tween(boxStroke, 0.4, {Color = C.button})
	end

	local function submit()
		if busy then
			return
		end
		local now = os.clock()
		if now < lockedUntil then
			setStatus("wait", C.red, math.ceil(lockedUntil - now) .. T("secs"))
			return
		end
		busy = true
		setStatus("checking", C.muted)
		local text = box.Text

		while true do
			local ok, a, b = verifyKey(text)
			if ok then
				Errors.Close() -- "tekrar dene" ile açık kaldıysa kapat
				local remaining = a - nowTime()
				setStatus("ok", C.green, formatRemaining(remaining))
				tween(boxStroke, 0.2, {Color = C.green})
				task.wait(0.7)
				tween(cardScale, 0.25, {Scale = 0.85}, Ease.Back, EaseDir.In)
				task.wait(0.25)
				unsub()
				ui:Destroy()
				keyToast(T("ok") .. formatRemaining(remaining), C.green)
				result:Fire(a, b)
				return
			end

			if isErr(a) then
				-- Ağ / anahtar hataları kendi menüsünü açar
				local action = Errors.Show(a, {detail = b, caps = Net.caps()})
				if action ~= "retry" then
					Windows.Restore()
					break
				end
			else
				Errors.Close(true)
				fails += 1
				if fails >= CFG.WrongTries then
					fails = 0
					lockedUntil = os.clock() + CFG.LockSeconds
					Errors.Show("E14", {lock = CFG.LockSeconds})
					Windows.Restore()
					break
				end
				setStatus(a, C.red)
				tween(boxStroke, 0.15, {Color = C.red})
				shake()
				break
			end
		end
		busy = false
		if statusKey == "checking" then
			statusKey = nil
			status.Text = ""
		end
	end

	enterBtn.Activated:Connect(submit)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
	getBtn.Activated:Connect(function()
		if copyText(K.K_URL) then
			linkBox.Visible = false
			setStatus("copied", C.green)
		else
			linkBox.Visible = true
			setStatus("manual", C.muted)
			pcall(function()
				linkBox:CaptureFocus()
			end)
		end
	end)

	return result.Event:Wait()
end

-- Kayıtlı anahtar hâlâ geçerliyse sessiz giriş: bitişZamanı, kod | nil, "gate" | nil, "abort"
local Auth = {}

function Auth.silent()
	local store = loadStore()
	local saved = store.last
	if not saved then
		return nil, "gate"
	end
	while true do
		local ok, a, b = verifyKey(saved)
		if ok then
			Errors.Close()
			keyToast(T("ok") .. formatRemaining(a - nowTime()), C.green)
			return a, b
		end
		local code = a
		if a == "invalid" or a == "empty" then
			code = "E12" -- kayıtlı anahtar listeden kaldırılmış
		end
		local action = Errors.Show(code, {detail = b, caps = Net.caps()})
		if action == "retry" and isErr(a) and a ~= "E13" then
			-- tekrar dene: döngü devam eder
		elseif action == "close" then
			return nil, "abort"
		else
			Errors.Close()
			return nil, "gate"
		end
	end
end

--------------------------------------------------------------------
-- F) Normal kod yükleyici
--------------------------------------------------------------------
local Loader = {loading = false}

-- Önceki pencereleri temizler (yeniden denemede çift pencere olmasın)
function Loader.cleanup()
	for _, g in ipairs(Shared.Windows) do
		if typeof(g) == "Instance" then
			pcall(function()
				g:Destroy()
			end)
		end
	end
	Shared.Windows = {}
	Windows.hidden = {}
end

-- Aşamalar: 1 indirme · 2 doğrulama · 3 derleme · 4 çalıştırma
-- Dönüş: true | false, hataKodu, ayrıntı, aşama
function Loader.load()
	Shared.Ready = false
	Shared.Failed = nil

	-- 1) İndirme (3 deneme; 404 / 429'da boşuna tekrar denenmez)
	local body, status, err
	for attempt = 1, 3 do
		body, status, err = Net.fetch(MAIN_URL .. "?v=" .. math.floor(nowTime() / 60), CFG.MainTimeout)
		if body then
			break
		end
		if status == 404 or status == 410 or status == 429 then
			break
		end
		if attempt < 3 then
			task.wait(attempt)
		end
	end
	if not body then
		local code = Net.classify(status, err)
		if code == "E03" then
			code = "E07" -- normal kod indirilemedi
		end
		return false, code, string.format("GET main -> status=%s err=%s", tostring(status), tostring(err)), 1
	end

	-- 2) Doğrulama: boş / çok kısa / web sayfası mı?
	local head = body:sub(1, 300):lower()
	if #body < 1000 or head:find("<!doctype", 1, true) or head:find("<html", 1, true) or head:match("^%s*404") then
		return false, "E08", string.format("size=%d bytes\nhead=%q", #body, body:sub(1, 120)), 2
	end

	-- 3) Derleme
	local okc, fn, cerr = pcall(loadstring, body, "=CR-SETA_Main")
	if not okc then
		return false, "E02", tostring(fn), 3
	end
	if type(fn) ~= "function" then
		return false, "E09", tostring(cerr), 3
	end

	-- 4) Çalıştırma: hata olursa ayrıntısıyla yakalanır, pencere hazır olana kadar beklenir
	Loader.cleanup()
	local finished, ran, rerr = false, false, nil
	task.spawn(function()
		local ok, e = xpcall(fn, function(m)
			return debug.traceback(tostring(m), 2)
		end)
		finished, ran, rerr = true, ok, e
	end)
	local t0 = os.clock()
	while os.clock() - t0 < CFG.ReadyTimeout do
		if Shared.Ready then
			return true
		end
		if Shared.Failed then
			local f = Shared.Failed
			Shared.Failed = nil
			return false, f.code or "E10", f.detail, f.stage or 4
		end
		if finished and not ran then
			return false, "E10", tostring(rerr), 4
		end
		task.wait(0.1)
	end
	return false, "E16", string.format("finished=%s ran=%s ready=false", tostring(finished), tostring(ran)), 4
end

-- Başarılı olana ya da kullanıcı kapatana kadar dener
function Loader.start()
	Loader.loading = true
	while true do
		local ok, code, detail, stage = Loader.load()
		if ok then
			Loader.loading = false
			Errors.Close() -- "tekrar dene" sonrası açık kalan çubuğu kapat
			Windows.hidden = {}
			return true
		end
		local action = Errors.Show(code, {detail = detail, stage = stage, caps = Net.caps()})
		if action ~= "retry" then
			Loader.loading = false
			return false
		end
	end
end

-- Normal kod çalışma sırasında hata bildirirse (ör. arayüz kurulumu patlarsa)
function Shared.Report(code, detail, stage)
	if Loader.loading then
		Shared.Failed = {code = code, detail = detail, stage = stage}
		return
	end
	task.spawn(function()
		if Shared.Lock then
			pcall(Shared.Lock)
		end
		local action = Errors.Show(code, {detail = detail, stage = stage or 4, caps = Net.caps()})
		if action == "retry" then
			Loader.cleanup()
			Loader.start()
		else
			Windows.Restore()
			if Shared.Unlock then
				pcall(Shared.Unlock)
			end
		end
	end)
end

--------------------------------------------------------------------
-- 5 saniyelik anahtar bekçisi
--  · kendi thread'inde çalışır, hiçbir oyun döngüsünü beklemez
--  · aynı anda tek istek (üst üste binmez), 8 sn zaman aşımı
--  · hata sürerse bekleme 5 -> 10 -> 20 -> 40 -> 60 sn'ye uzar (sunucuyu yormaz)
--  · 429 gelirse Retry-After süresi kadar bekler
--  · hata menüsü açıkken kontrol durur
--  · süre dolumu ağa gitmeden yerelde kontrol edilir
--  · jeton: kapı açıkken "geçersiz" olur, normal kod özellikleri kilitler
--------------------------------------------------------------------
local Watch = {}

-- Süre doldu / anahtar kaldırıldı: özellikleri durdur, yeni anahtar iste
local function relogin(reason, detail)
	Token.set(false, 0)
	if Shared.Lock then
		pcall(Shared.Lock)
	end
	Errors.Show(reason, {detail = detail})
	local expiry, code = Gate.run()
	Token.set(true, expiry)
	Windows.Restore()
	if Shared.Unlock then
		pcall(Shared.Unlock)
	end
	return expiry, code
end

-- Liste uzun süre ulaşılamazsa: bağlantı gelene kadar kilitli bekler
local function waitOnline(detail)
	if Shared.Lock then
		pcall(Shared.Lock)
	end
	while true do
		Errors.Show("E15", {detail = detail})
		local keys, _, d = Keys.fetch()
		if keys then
			Errors.Close(true)
			if Shared.Unlock then
				pcall(Shared.Unlock)
			end
			return keys
		end
		detail = d
	end
end

function Watch.start(code, expiry)
	local mine = Shared
	local fails, offlineSince, delay = 0, nil, CFG.Poll
	task.spawn(function()
		while Env.CRSETA == mine do
			task.wait(delay)
			if Env.CRSETA ~= mine then
				return
			end
			if not Errors.Session then
				if nowTime() >= expiry then
					expiry, code = relogin("E13", "key lifetime ended")
					fails, offlineSince, delay = 0, nil, CFG.Poll
				else
					local keys, errCode, detail = Keys.fetch()
					if keys then
						fails, offlineSince, delay = 0, nil, CFG.Poll
						if not keys[code] then
							expiry, code = relogin("E12", "key removed from list")
						end
					else
						fails += 1
						offlineSince = offlineSince or os.clock()
						delay = math.min(CFG.PollMax, CFG.Poll * 2 ^ math.min(fails, 4))
						if errCode == "E04" then
							delay = math.max(delay, Keys.retryAfter or 60)
						end
						if os.clock() - offlineSince >= CFG.OfflineGrace then
							Token.set(false, 0)
							local list = waitOnline(detail)
							Token.set(true, expiry)
							fails, offlineSince, delay = 0, nil, CFG.Poll
							if not list[code] then
								expiry, code = relogin("E12", "key removed from list")
							end
						end
					end
				end
			end
		end
	end)
end

--------------------------------------------------------------------
-- Başlangıç
--------------------------------------------------------------------
local function boot()
	-- jeton varlığı + kalp atışı: kapı açıkken bile "yükleyici hayatta" bilgisi verir
	Token.set(false, 0)
	local mine = Shared
	task.spawn(function()
		while Env.CRSETA == mine do
			task.wait(5)
			pcall(Token.write)
		end
	end)

	local caps = Net.caps()
	if not caps.http then
		Errors.Show("E01", {caps = caps, detail = "request / http_request / HttpGet not found"})
		return
	end
	if not caps.loadstring then
		Errors.Show("E02", {caps = caps, detail = "loadstring is missing or disabled"})
		return
	end

	local expiry, code = Auth.silent()
	if not expiry then
		if code == "abort" then
			return
		end
		expiry, code = Gate.run()
	end

	-- anahtar doğrulandı: normal koda yetki ver, sonra onu yükle
	Token.set(true, expiry)
	if not Loader.start() then
		Token.set(false, 0)
		return
	end
	Watch.start(code, expiry)
end

local booted, bootErr = xpcall(boot, function(e)
	return debug.traceback(tostring(e), 2)
end)
if not booted then
	warn("[CR-SETA] " .. tostring(bootErr))
	local text = tostring(bootErr)
	local code = (text:find("PlayerGui", 1, true) or text:find("Parent", 1, true)) and "E17" or "E18"
	pcall(function()
		Errors.Show(code, {detail = text})
	end)
end
