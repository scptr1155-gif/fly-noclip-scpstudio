local function setupCharacter(char)
	stopFly()
	stopClip()

	Character = char
	Humanoid = char:WaitForChild(S.HUMANOID, 10)
	Root = char:WaitForChild(S.ROOTPART, 10)
	if not Humanoid or not Root then
		return
	end

	Humanoid[S.DIED]:Connect(function()
		stopFly()
		stopClip()
		if Refresh then
			Refresh()
		end
	end)

	if Refresh then
		Refresh()
	end
end

Player[S.CHARACTERADDED]:Connect(setupCharacter)
Player[S.CHARACTERREMOVING]:Connect(function()
	stopFly()
	stopClip()
	if Refresh then
		Refresh()
	end
end)
if Player.Character then
	task.spawn(setupCharacter, Player.Character)
end

