local function new(class, props, parent)
	local object = Instance.new(class)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function tween(object, duration, props, style, direction)
	local t = TweenService:Create(object, TweenInfo.new(duration, style or Ease.Quad, direction or EaseDir.Out), props)
	t:Play()
	return t
end

local function corner(object, radius)
	return new("UICorner", {CornerRadius = UDim.new(0, radius)}, object)
end

local function stroke(object, color, thickness, transparency)
	return new("UIStroke", {Color = color, Thickness = thickness or 1, Transparency = transparency or 0}, object)
end

local function fx(button, radius, hover)
	local base = button.BackgroundColor3
	local scale = new("UIScale", {}, button)
	button.MouseEnter:Connect(function()
		tween(button, 0.15, {BackgroundColor3 = hover or base:Lerp(Color3.new(1, 1, 1), 0.14)})
	end)
	button.MouseLeave:Connect(function()
		tween(button, 0.2, {BackgroundColor3 = base})
		tween(scale, 0.12, {Scale = 1})
	end)
	button.MouseButton1Down:Connect(function()
		tween(scale, 0.08, {Scale = 0.97})
	end)
	button.MouseButton1Up:Connect(function()
		tween(scale, 0.18, {Scale = 1}, Ease.Back)
	end)
end

