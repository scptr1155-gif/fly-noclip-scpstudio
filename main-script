		for code, b in pairs(buttons) do
			local on = code == Lang.Code
			tween(b, 0.15, {BackgroundColor3 = on and C.accent or C.button, TextColor3 = on and C.text or C.muted})
		end
	end
	paint()
	local unsub = Lang.Subscribe(paint)
	bar.Destroying:Connect(unsub)
	return bar
end

local function formatRemaining(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format(T("hm"), math.floor(seconds / 3600), math.floor((seconds % 3600) / 60))
end

