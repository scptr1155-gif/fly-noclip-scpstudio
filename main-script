			{etiket = T("kapat"), renk = C.button, kimlik = "kapat"},
		})
		geri dönmek
	son

	-- Kayıtlı anahtar mevcut durumda sessiz giriş
	yerel son kullanma tarihi, kod
	yerel mağaza = loadStore()
	eğer store.last ise o zaman
