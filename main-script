local openGate, launch, startWatcher

-- Arka plan key izleyici:
--  * aralık 60 sn yerine 300 sn
--  * sadece gereken liste indirilir (rol biliniyorsa tek istek)
--  * ağ hatasında aralık katlanarak uzar (sürekli donma yapmaz)
function startWatcher(firstDelay)
    getgenv().CR_WATCH = (getgenv().CR_WATCH or 0) + 1
    local id = getgenv().CR_WATCH

    task.spawn(function()
        local waitTime = firstDelay or SETTINGS.WATCH_FIRST
        local failStreak = 0

        while true do
            task.wait(waitTime)
            if getgenv().CR_WATCH ~= id then return end
            waitTime = SETTINGS.WATCH_INTERVAL

            if cfg.key then
                local ok, role = pcall(lookupKey, cfg.key, cfg.role, SETTINGS.LIST_TTL)
                if not ok then role = "error" end
                if getgenv().CR_WATCH ~= id then return end

                if role == nil then
                    cfg.key = nil
                    cfg.role = nil
                    saveCfg()
                    getgenv().CR_ROLE = nil
                    if getgenv().CR_Close then pcall(getgenv().CR_Close) end
                    openGate(getError("key_removed"))
                    return
                elseif role == "error" then
                    failStreak = failStreak + 1
                    waitTime = math.min(SETTINGS.WATCH_INTERVAL * (2 ^ failStreak), SETTINGS.WATCH_MAX_BACKOFF)
                else
                    failStreak = 0
                    getgenv().CR_ROLE = role
                    if cfg.role ~= role then
                        cfg.role = role
                        saveCfg()
                    end
                end
            end
        end
    end)
end

-- Ana script ayrı thread'de indirilir ve çalıştırılır (arayüz donmaz).
-- onLoaded: script indirilip derlendikten sonra (loading kutusunu kapatmak için) çağrılır.
function launch(firstCheckDelay, onLoaded)
    task.spawn(function()
        task.wait() -- bir kare bekle: önce arayüz çizilsin, sonra ağır iş başlasın

        local fn
        local ok, err = pcall(function()
            local src, e = httpGet(URL_SCRIPT)
            if not src then error("download failed: " .. tostring(e)) end
            local f, perr = loadstring(src)
            if not f then error(perr) end
            fn = f
        end)

        if onLoaded then pcall(onLoaded) end

        if not ok then
            warn("[cr-game] " .. tostring(err))
            notify(getError("script_load_failed"))
            openGate(getError("script_load_failed"))
            return
        end

        startWatcher(firstCheckDelay)

        local ran, runErr = pcall(fn)
        if not ran then
            getgenv().CR_WATCH = (getgenv().CR_WATCH or 0) + 1 -- izleyiciyi durdur
            warn("[cr-game] " .. tostring(runErr))
            notify(getError("script_load_failed"))
            openGate(getError("script_load_failed"))
        end
    end)
end

