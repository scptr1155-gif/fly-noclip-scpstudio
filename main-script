local function getGlobal(name)
	local ok, value = pcall(function()
		return (getgenv and getgenv() or getfenv())[name]
	end)
	return ok and value or nil
end

local function nowTime()
	local ok, value = pcall(function()
		return workspace[K.K_GSTN](workspace)
	end)
	if ok and type(value) == "number" then
		return value
	end
	return os.time()
end

local function khash(str)
	local h1, h2 = 5381, 52711
	for i = 1, #str do
		local b = str:byte(i)
		h1 = (h1 * 33 + b) % 4294967296
		h2 = (h2 * 131 + b * i) % 4294967291
	end
	return string.format("%08x%08x", h1, h2)
end

local function mac(...)
	return khash(table.concat({...}, "|") .. K.K_SALT)
end

local function normalizeKey(text)
	return ((tostring(text or ""):gsub("%s+", "")):upper())
end

local function httpGet(url)
	for _, name in ipairs({K.K_RQ1, K.K_RQ2}) do
		local fn = getGlobal(name)
		if type(fn) == "function" then
			local ok, res = pcall(fn, {Url = url, Method = "GET"})
			if ok and type(res) == "table" and type(res.Body) == "string"
				and (res.StatusCode == 200 or res.Success) then
				return res.Body
			end
		end
	end
	local ok, res = pcall(function()
		return game[K.K_HG](game, url, true)
	end)
	if ok and type(res) == "string" and #res > 0 then
		return res
	end
	return nil
end


