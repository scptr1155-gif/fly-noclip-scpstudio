-- Sürükleme: hareket bağlantısı SADECE sürüklerken açık kalır.
-- (Eskiden her fare hareketinde sürekli çalışan global bir bağlantı vardı.)
function UI.drag(handle, frame, conns)
    local c = handle.InputBegan:Connect(function(i)
        local t = i.UserInputType
        if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end

        local startInput = i.Position
        local startPos = frame.Position
        local moveConn, endConn

        local function stop()
            if moveConn then moveConn:Disconnect() moveConn = nil end
            if endConn then endConn:Disconnect() endConn = nil end
        end

        moveConn = UIS.InputChanged:Connect(function(m)
            local mt = m.UserInputType
            if mt == Enum.UserInputType.MouseMovement or mt == Enum.UserInputType.Touch then
                local d = m.Position - startInput
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)

        endConn = i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then stop() end
        end)
    end)
    if conns then table.insert(conns, c) end
end

