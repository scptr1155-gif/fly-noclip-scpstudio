	if ClipConn then
		ClipConn:Disconnect()
		ClipConn = nil
	end
	if ClipAddConn then
		ClipAddConn:Disconnect()
		ClipAddConn = nil
	end

	for part, original in pairs(ClipParts) do
		if part.Parent then
			part[S.CANCOLLIDE] = original
		end
	end
	ClipParts = {}
end

local function startClip()
	if State.NoClip or not Character then
		return false
	end
	State.NoClip = true

	for _, descendant in ipairs(Character:GetDescendants()) do
		trackPart(descendant)
	end
	ClipAddConn = Character[S.DESCENDANTADDED]:Connect(trackPart)

	ClipConn = RunService[S.STEPPED]:Connect(function()
		for part in pairs(ClipParts) do
			if part.Parent then
				part[S.CANCOLLIDE] = false
			else
				ClipParts[part] = nil
			end
		end
	end)

	return true
end

