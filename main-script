    local barBg = UI.new("Frame", {Position = UDim2.new(0.5, -140, 0, 172), Size = UDim2.new(0, 280, 0, 4), BackgroundColor3 = UI.PANEL2, BorderSizePixel = 0}, keyPage)
    UI.corner(barBg, 2)
    local bar = UI.new("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, barBg)
    UI.corner(bar, 2)
    UI.gradient(bar, UI.GREEN1, UI.ACCENT1, 0)

    local status = UI.new("TextLabel", {
        Position = UDim2.new(0, 10, 0, 182), Size = UDim2.new(1, -20, 0, 18), BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium, TextSize = 12, Text = "", TextColor3 = Color3.new(1, 1, 1),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, keyPage)

    local langBtn = UI.button(keyPage, "", UDim2.new(0.5, -60, 0, 208), UDim2.new(0, 120, 0, 28), UI.PANEL2, UI.PANEL)
    langBtn.TextSize = 12

    local function setStatus(msg, good)
        status.Text = msg
        status.TextColor3 = good and Color3.fromRGB(90, 230, 130) or Color3.fromRGB(255, 100, 100)
    end

    local function refreshTexts()
        local t = TEXT[curLang()]
        sub.Text = t.sub
        titleLabel.Text = t.title
        box.PlaceholderText = t.placeholder
        getKeyBtn.Text = t.getkey
        verifyBtn.Text = t.verify
        langBtn.Text = t.lang
    end

    local function setPage(p)
        langPage.Visible = (p == "lang")
        keyPage.Visible = (p == "key")
    end

    local function chooseLang(code)
        getgenv().CR_LANG = code
        cfg.lang = code
        saveCfg()
        refreshTexts()
        setPage("key")
    end
    enBtn.MouseButton1Click:Connect(function() chooseLang("EN") end)
    trBtn.MouseButton1Click:Connect(function() chooseLang("TR") end)

    langBtn.MouseButton1Click:Connect(function()
        chooseLang(curLang() == "TR" and "EN" or "TR")
        setStatus("", true)
    end)

    getKeyBtn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(GET_KEY_URL)
            setStatus(TEXT[curLang()].copied, true)
        else
            setStatus(getError("clipboard_unsupported"), false)
        end
    end)

    local busy = false
    verifyBtn.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true

        local input = (box.Text:gsub("%s+", ""))
        if input == "" then
            setStatus(getError("empty_key"), false)
            busy = false
            return
        end

        verifyBtn.Text = "..."
        local ok, role = pcall(lookupKey, input, nil, SETTINGS.VERIFY_MIN_AGE)
        if not ok then
            lastFetchError = tostring(role)
            role = "error"
        end
        verifyBtn.Text = TEXT[curLang()].verify

        if role == "error" then
            setStatus(getError("code_load_failed") .. " (" .. lastFetchError .. ")", false)
            busy = false
            return
        end
        if not role then
            setStatus(getError("invalid_key"), false)
            busy = false
            return
        end

        cfg.key = input
        cfg.role = role
        saveCfg()
        getgenv().CR_ROLE = role

        setStatus(role == "admin" and TEXT[curLang()].admin or TEXT[curLang()].success, true)
        UI.tween(bar, 0.6, {Size = UDim2.new(1, 0, 1, 0)})
        task.wait(0.6)
        gui:Destroy()
        launch(SETTINGS.WATCH_FIRST)
    end)

    refreshTexts()
    if message then setStatus(message, false) end
    setPage(cfg.lang and "key" or "lang")
end

--------------------------------------------------------------------
-- 9) Loading kutusu (tek döngülü tween, sürekli yeni tween oluşturmaz)
--------------------------------------------------------------------
local function showLoading()
    local alive = true
    local gui, runTween
    local ok, err = pcall(function()
        local parent = UI.parent()
        local old = parent:FindFirstChild("CRGameLoading")
        if old then old:Destroy() end

        gui = UI.new("ScreenGui", {Name = "CRGameLoading", ResetOnSpawn = false, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, parent)

        local card = UI.new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 260, 0, 120), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, gui)
        UI.corner(card, 16)
        UI.gradient(card, Color3.fromRGB(24, 24, 40), Color3.fromRGB(12, 12, 20), 90)
        local stroke = UI.new("UIStroke", {Thickness = 1.5, Color = Color3.new(1, 1, 1)}, card)
        UI.gradient(stroke, UI.ACCENT1, UI.ACCENT2, 45)

        local logo = UI.new("TextLabel", {
            Position = UDim2.new(0, 0, 0, 12), Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1,
            Text = "cr-game", Font = Enum.Font.GothamBlack, TextSize = 28, TextColor3 = Color3.new(1, 1, 1),
        }, card)
        UI.gradient(logo, UI.ACCENT1, UI.ACCENT2, 0)

        local label = UI.new("TextLabel", {
            Position = UDim2.new(0, 0, 0, 54), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = Color3.fromRGB(220, 220, 235), Text = "",
        }, card)

        local barBg = UI.new("Frame", {
            Position = UDim2.new(0.5, -90, 0, 88), Size = UDim2.new(0, 180, 0, 5),
            BackgroundColor3 = UI.PANEL2, BorderSizePixel = 0, ClipsDescendants = true,
        }, card)
        UI.corner(barBg, 3)
        local runner = UI.new("Frame", {
            Position = UDim2.new(-0.4, 0, 0, 0), Size = UDim2.new(0.4, 0, 1, 0),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, barBg)
        UI.corner(runner, 3)
        UI.gradient(runner, UI.ACCENT1, UI.ACCENT2, 0)

        if LITE then
            runner.Position = UDim2.new(0.3, 0, 0, 0) -- lite: sabit çubuk, animasyon yok
        else
            -- Tek bir tween, sonsuz tekrar (-1)
            runTween = TweenService:Create(
                runner,
                TweenInfo.new(0.8, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
                {Position = UDim2.new(1, 0, 0, 0)}
            )
            runTween:Play()
        end

        local base
        if cfg.lang == "TR" then base = TEXT.TR.loading
        elseif cfg.lang == "EN" then base = TEXT.EN.loading
        else base = TEXT.EN.loading .. " / " .. TEXT.TR.loading end

        task.spawn(function()
            local n = 0
            while alive and gui and gui.Parent do
                n = (n % 3) + 1
                label.Text = base .. string.rep(".", n)
                task.wait(0.5)
            end
        end)
    end)
    if not ok then warn("[cr-game] loading gui error: " .. tostring(err)) end

    return function()
        alive = false
        if runTween then pcall(function() runTween:Cancel() end) end
        if gui then pcall(function() gui:Destroy() end) end
    end
end

--------------------------------------------------------------------
-- 10) Başlangıç
--------------------------------------------------------------------
local function start()
    loadCfg()
    getgenv().CR_LANG = cfg.lang
    print("[cr-game] config loaded. lang=" .. tostring(cfg.lang) .. " key=" .. tostring(cfg.key ~= nil) .. " lite=" .. tostring(LITE))

    local closeLoading = showLoading()

    if cfg.lang and cfg.key then
        -- Kayıtlı key var: beklemeden direkt script, doğrulama arka planda (ilk kontrol 20 sn sonra)
        getgenv().CR_ROLE = cfg.role or "user"
        launch(SETTINGS.WATCH_FIRST, closeLoading)
    else
        -- İlk giriş: kısa loading, sonra (dil seçimi ->) key menüsü
        task.wait(0.8)
        closeLoading()
        openGate()
    end
end

local ok, err = pcall(start)
if not ok then
    warn("[cr-game] start error: " .. tostring(err))
    notify("Error: " .. tostring(err))
    local ok2, err2 = pcall(function()
        cfg = {}
        openGate()
    end)
    if not ok2 then
        warn("[cr-game] gui error: " .. tostring(err2))
        notify("GUI error: " .. tostring(err2))
    end
end
