local function goBar(s)
	tween(s.bigText, 0.15, {TextTransparency = 1})
	tween(s.subText, 0.15, {TextTransparency = 1})
	tween(s.box, 0.4, {Size = UDim2.fromOffset(300, 46)}, Ease.Quint)
	tween(s.boxCorner, 0.4, {CornerRadius = UDim.new(0, 23)}, Ease.Quint)
	tween(s.spinner, 0.4, {Position = UDim2.new(0, 30, 0.5, 0)}, Ease.Quint)
	tween(s.barText, 0.35, {TextTransparency = 0})
end

local function goBig(s, W, H)
	tween(s.barText, 0.15, {TextTransparency = 1})
	tween(s.box, 0.5, {Size = UDim2.fromOffset(W, H)}, Ease.Quint)
	tween(s.boxCorner, 0.5, {CornerRadius = UDim.new(0, 18)}, Ease.Quint)
	tween(s.spinner, 0.5, {Position = UDim2.new(0.5, 0, 0.5, -20)}, Ease.Quint)
	task.delay(0.25, function()
		tween(s.bigText, 0.3, {TextTransparency = 0})
		tween(s.subText, 0.3, {TextTransparency = 0})
	end)
end

local function collapse(s)
	if s.content then
		tween(s.content, 0.2, {GroupTransparency = 1})
	end
	tween(s.loading, 0.2, {GroupTransparency = 1})
	task.wait(0.2)
	tween(s.box, 0.3, {Size = UDim2.fromOffset(56, 56), BackgroundTransparency = 1}, Ease.Quint)
	tween(s.boxCorner, 0.3, {CornerRadius = UDim.new(0, 14)})
	tween(s.pop, 0.3, {Scale = 0.3}, Ease.Back, EaseDir.In)
	tween(s.dim, 0.3, {BackgroundTransparency = 1})
	task.wait(0.35)
	for _, unsub in ipairs(s.unsubs) do
		unsub()
	end
	if s.contentUnsub then
		s.contentUnsub()
	end
	s.gui:Destroy()
end

-- Hata içeriği (şablona göre farklı menü)
local function buildContent(s, code, def, ctx, W, H, finish)
	local content = new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, GroupTransparency = 1,
	}, s.box)
	local binds = {}
	local function bind(fn)
		binds[#binds + 1] = fn
		fn()
	end
	local unsub = Lang.Subscribe(function()
		for _, fn in ipairs(binds) do
			pcall(fn)
		end
	end)

	local function report()
		return string.format("CR-SETA %s | %s\n%s\nlang=%s time=%s", code, def.T.EN[1],
			tostring(ctx.detail or "-"), Lang.Code, os.date("!%Y-%m-%d %H:%M:%S"))
	end
	local function flash(b, key)
		b.Text = T("copiedBtn")
		task.delay(1.4, function()
			if b.Parent then
				b.Text = T(key)
			end
		end)
	end

	-- ortak başlık
	local icon = new("Frame", {Position = UDim2.fromOffset(20, 20), Size = UDim2.fromOffset(46, 46), BackgroundColor3 = def.color, BorderSizePixel = 0}, content)
	corner(icon, 23)
	new("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
		TextSize = 24, TextColor3 = Color3.new(1, 1, 1), Text = def.icon,
	}, icon)
	local title = new("TextLabel", {
		Position = UDim2.fromOffset(80, 20), Size = UDim2.new(1, -100, 0, 26), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, TextScaled = true, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
	}, content)
	new("UITextSizeConstraint", {MaxTextSize = 17, MinTextSize = 10}, title)
	local codeLabel = new("TextLabel", {
		Position = UDim2.fromOffset(80, 46), Size = UDim2.new(1, -100, 0, 20), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.muted, TextXAlignment = Enum.TextXAlignment.Left,
	}, content)
	local desc = new("TextLabel", {
		Position = UDim2.fromOffset(20, 80), Size = UDim2.new(1, -40, 0, 60), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Color3.fromRGB(205, 216, 236), TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	}, content)
	bind(function()
		local tx = def.T[Lang.Code] or def.T.EN
		title.Text, desc.Text = tx[1], tx[2]
		codeLabel.Text = T("code") .. ": " .. code
