-- Key kontrolü
--------------------------------------------------------------------
local function fetchKeys()
    local ok, res = pcall(function() return game:HttpGet(URL_KEY .. "?t=" .. tostring(os.time())) end)
    if ok and type(res) == "string" and res ~= "" and res:sub(1, 3) ~= "404" then
        return res
    end
    return nil
end
local function keyExists(keys, input)
    for line in keys:gmatch("[^\r\n]+") do
        if (line:gsub("%s+", "")) == input then return true end
    end
    return false
end

local openGate, launch, startWatcher

function startWatcher()
    getgenv().CR_WATCH = (getgenv().CR_WATCH or 0) + 1
    local id = getgenv().CR_WATCH
    task.spawn(function()
        while true do
            task.wait(60)
            if getgenv().CR_WATCH ~= id then return end
            local keys = fetchKeys()
            if keys and cfg.key and not keyExists(keys, cfg.key) then
                cfg.key = nil
                saveCfg()
                if getgenv().CR_Close then pcall(getgenv().CR_Close) end
                openGate(getError("key_removed"))
                return
            end
        end
    end)
end

function launch()
    local ok, err = pcall(function() loadstring(game:HttpGet(URL_SCRIPT))() end)
    if not ok then
        warn("[cr-game] " .. tostring(err))
        openGate(getError("script_load_failed"))
        return false
    end
    startWatcher()
    return true
end

