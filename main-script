-- Dragging
do
	local dragging, dragInput, dragStart, startPos
	Main.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local relY = input.Position.Y - Main.AbsolutePosition.Y
			if relY <= 46 then
				dragging = true
				dragStart = input.Position
				startPos = Main.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end
	end)
	Main.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local delta = input.Position - dragStart
			Main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

-- Get Key
GetKey.MouseButton1Click:Connect(function()
	local clip = ENV[D(FN_CLIP)] or ENV.toclipboard
	if type(clip) ~= "function" then
		SetStatus("Clipboard is not supported by your executor.", RED)
		return
	end
	local ok = pcall(clip, D(GET_KEY_LINK))
	if ok then
		GetKey.Text = "Link Copied!"
		SetStatus("Key link copied. Open it in your browser and complete the steps.", GRAY)
		task.delay(1.5, function()
			if GetKey.Parent then
				GetKey.Text = "Get Key"
			end
		end)
	else
		SetStatus("Could not copy the link.", RED)
	end
end)

-- Verify
local Busy = false

local function Run()
	Busy = true
	local input = Trim(KeyBox.Text)
	if input == "" then
		SetStatus("Please enter a key.", RED)
		Busy = false
		return
	end

	SetStatus("Checking key...", GRAY)
	local ok, remote = pcall(function()
		return game[D(FN_HTTP)](game, D(KEY_URL))
	end)
	if not ok or type(remote) ~= "string" or remote == "" then
		SetStatus("Could not reach the key server. Check your connection or executor.", RED)
		Busy = false
		return
	end

	if Trim(remote) ~= input then
		SetStatus("Invalid key. Click Get Key to get a valid one.", RED)
		Busy = false
		return
	end

	SetStatus("Key accepted! Loading script...", GREEN)
	task.wait(0.5)
	Gui.Enabled = false

	local loaded, err = pcall(function()
		local ls = ENV[D(FN_LOAD)]
		local src = game[D(FN_HTTP)](game, D(SCRIPT_URL))
		ls(src)()
	end)

	if loaded then
		Gui:Destroy()
	else
		Gui.Enabled = true
		SetStatus("Failed to load the script. Try again.", RED)
		warn("[SCP Studio] " .. tostring(err))
	end
	Busy = false
end

local function Submit()
	if Busy then
		return
	end
	local ok, err = pcall(Run)
	if not ok then
		Busy = false
		SetStatus("Unexpected error. Try again.", RED)
		warn("[SCP Studio] " .. tostring(err))
	end
end

Verify.MouseButton1Click:Connect(Submit)
KeyBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		Submit()
	end
end)
Close.MouseButton1Click:Connect(function()
	Gui:Destroy()
end)
