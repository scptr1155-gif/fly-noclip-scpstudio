-- Duvar saati (saniye). os.clock() CPU süresidir, ilerlemeyi beklerken.
yerel tickFn = rawget(_G, "tick")
yerel fonksiyon mono()
	if type(tickFn) == "function" then
		yerel tamam, v = pcall(tickFn)
		eğer uygunsa ve type(v) == "sayı" ise
			dönüş v
		son
	son
	os.time'ı döndürün.
son

yerel fonksiyon nowTime()
