local Errors
do
    local ok, res = pcall(function() return loadstring(game:HttpGet(URL_ERROR))() end)
    if ok and type(res) == "table" then
        Errors = res
    else
        Errors = {
            EN = { code_load_failed = "Code could not be loaded!", error_file_failed = "Error file could not be loaded!" },
            TR = { code_load_failed = "Kod yüklenemedi!", error_file_failed = "Hata dosyası yüklenemedi!" },
        }
    end
end
local function curLang()
    return (getgenv().CR_LANG == "TR") and "TR" or "EN"
end
local function getError(name)
    local t = Errors[curLang()] or Errors.EN
    return t[name] or name
end
