end

local function refreshTexts()
    local t = TEXT[getgenv().CR_LANG]
    title.Text = t.title
    box.PlaceholderText = t.placeholder
    getKeyBtn.Text = t.getkey
    verifyBtn.Text = t.verify
    langBtn.Text = t.lang
end
refreshTexts()

langBtn.MouseButton1Click:Connect(function()
    getgenv().CR_LANG = (getgenv().CR_LANG == "TR") and "EN" or "TR"
    status.Text = ""
    refreshTexts()
end)

getKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GET_KEY_URL)
        setStatus(TEXT[getgenv().CR_LANG].copied, true)
    else
        setStatus(getError("clipboard_unsupported"), false)
    end
end)

local busy = false
verifyBtn.MouseButton1Click:Connect(function()
    if busy then return end
    busy = true

    local input = box.Text:gsub("%s+", "")
    if input == "" then
        setStatus(getError("empty_key"), false)
        busy = false
        return
    end

    local ok, keys = pcall(function() return game:HttpGet(URL_KEY) end)
    if not ok or type(keys) ~= "string" or keys == "" then
        setStatus(getError("code_load_failed"), false)
        busy = false
        return
    end

    local valid = false
    for line in keys:gmatch("[^\r\n]+") do
        if line:gsub("%s+", "") == input then valid = true break end
    end

    if not valid then
        setStatus(getError("invalid_key"), false)
        busy = false
        return
    end

    setStatus(TEXT[getgenv().CR_LANG].success, true)
    task.wait(0.8)

    local ok2, err = pcall(function() loadstring(game:HttpGet(URL_SCRIPT))() end)
    if ok2 then
        gui:Destroy()
    else
        warn("[cr-game] " .. tostring(err))
        setStatus(getError("script_load_failed"), false)
        busy = false
    end
end)
