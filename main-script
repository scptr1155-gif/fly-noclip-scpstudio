local function setPanelHidden(hidden)
	State.Hidden = hidden
	if hidden then
		tween(Main, 0.28, {Size = UDim2.fromOffset(352, 60)}, Ease.Quint)
		task.delay(0.28, function()
			if State.Hidden then
				Main.Visible = false
