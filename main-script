	return _G
end

local function stateSig(ok, exp, uid, beat)
	return mac(ok and "1" or "0", tostring(exp), tostring(uid), tostring(beat))
end

local function readState()
	local st = stateEnv()[K.K_STATE]
	if type(st) ~= "table" then
		return nil
	end
	if st.uid ~= Player.UserId or st.sig ~= stateSig(st.ok, st.exp, st.uid, st.beat) then
		return nil
	end
	return st
end

-- ana script hayatta mı (kalp atışı yeni mi)
local function mainAlive(st)
	return st ~= nil and math.abs(nowTime() - st.beat) < 60
end

-- anahtar doğrulanmış, süresi dolmamış ve ana script hayatta mı
local function stateValid(st)
	return st ~= nil and st.ok == true and nowTime() < st.exp and mainAlive(st)
end

local function loadAndRun(url, label)
	local body = httpGet(url .. "?t=" .. tostring(math.floor(nowTime())))
	if not body then
		return false, "net"
	end
	local ls = getGlobal(K.K_LS) or loadstring
	if type(ls) ~= "function" then
		return false, "loadstring"
	end
	local fn, err = ls(body)
	if not fn then
		return false, tostring(err)
	end
	task.spawn(function()
		local ok, e = pcall(fn)
		if not ok then
			warn("[CR-SETA/" .. label .. "] " .. tostring(e))
		end
	end)
	return true
end

local function fetchKeys()
	local body = httpGet(K.K_RAW .. "?t=" .. tostring(math.floor(nowTime())))
	if not body then
		return nil
	end
	local keys = {}
	for line in body:gmatch("[^\r\n]+") do
		local code = normalizeKey(line)
		if code ~= "" and code:sub(1, 1) ~= "#" then
			keys[code] = true
		end
	end
	return keys
end

-- Yerel kayıt: her kodun ilk kullanım zamanı (MAC ile korunur)
local MemoryStore = {}

local function loadStore()
	local store = {started = {}, last = nil}
	local raw = MemoryStore.raw
	local isfile, readfile = getGlobal(K.K_IF), getGlobal(K.K_RF)
	if type(isfile) == "function" and type(readfile) == "function" then
		local ok, data = pcall(function()
			if isfile(K.K_FILE) then
				return readfile(K.K_FILE)
			end
		end)
		if ok and type(data) == "string" then
			raw = data
		end
	end
	for line in tostring(raw or ""):gmatch("[^\r\n]+") do
		local kind, a, b, c = line:match("^(%a)|([^|]*)|([^|]*)|?([^|]*)$")
		if kind == "K" and mac("K", a, b) == c then
			store.started[a] = tonumber(b)
		elseif kind == "L" and mac("L", a) == b then
			store.last = a
		end
	end
	return store
end

local function saveStore(store)
	local lines = {}
	for id, started in pairs(store.started) do
		table.insert(lines, string.format("K|%s|%s|%s", id, tostring(started), mac("K", id, tostring(started))))
	end
	if store.last then
		table.insert(lines, string.format("L|%s|%s", store.last, mac("L", store.last)))
	end
	local data = table.concat(lines, "\n")
	MemoryStore.raw = data
	local writefile = getGlobal(K.K_WF)
	if type(writefile) == "function" then
		pcall(writefile, K.K_FILE, data)
	end
end

-- Doğrulama: ok, bitişZamanı | false, hata ("empty" / "net" / "invalid" / "expired")
local function verifyKey(input, keysOverride)
	local code = normalizeKey(input)
	if code == "" then
		return false, "empty"
	end
	local keys = keysOverride or fetchKeys()
	if not keys then
		return false, "net"
	end
	if not keys[code] then
		return false, "invalid"
	end

	local store = loadStore()
	local id = khash(code)
	local t = nowTime()
	local started = store.started[id]
	if not started then
		started = t
		store.started[id] = started
	end
	if t >= started + KEY_LIFETIME then
		return false, "expired"
	end
	store.last = code
	saveStore(store)
	return true, started + KEY_LIFETIME, code
end

local function formatRemaining(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	if State.Language == "TR" then
		return string.format("%d sa %d dk", h, m)
	end
	return string.format("%dh %dm", h, m)
end

