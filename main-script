local Gate = {}

function Gate.run(message)
	local ui = new("ScreenGui", {Name = "crseta_key", ResetOnSpawn = false, DisplayOrder = 100}, PlayerGui)
	Shared.Register(ui)
	-- Modal: Shift Lock açıkken bile fare serbest kalır
