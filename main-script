function openGate(message)
    local parent = UI.parent()
    local old = parent:FindFirstChild("CRGameGate")
    if old then old:Destroy() end

    local gui = UI.new("ScreenGui", {Name = "CRGameGate", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, parent)
    local conns = {}
    gui.Destroying:Connect(function() for _, c in ipairs(conns) do c:Disconnect() end end)

    local card = UI.new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 340, 0, 330), BackgroundColor3 = Color3.new(1, 1, 1),
