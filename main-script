local function tr(k)
    return L[State.Language][k] or k
end

local Character,Humanoid,Root
local Velocity,Gyro
local FlyConnection,ClipConnection
local Keys={}

local function stopFly()
    State.Fly=false
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection=nil
    end
    if Velocity then Velocity:Destroy() Velocity=nil end
    if Gyro then Gyro:Destroy() Gyro=nil end
    if Humanoid then
        Humanoid.PlatformStand=false
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function startFly()
    if not Root or not Humanoid or Humanoid.Health<=0 then return end
    if State.Fly then return end

    State.Fly=true
    Velocity=Instance.new("BodyVelocity")
    Velocity.MaxForce=Vector3.new(1e6,1e6,1e6)
    Velocity.Velocity=Vector3.zero
    Velocity.Parent=Root

    Gyro=Instance.new("BodyGyro")
    Gyro.MaxTorque=Vector3.new(1e6,1e6,1e6)
    Gyro.P=10000
    Gyro.Parent=Root

    Humanoid.PlatformStand=true

    FlyConnection=RunService.RenderStepped:Connect(function()
        if not State.Fly or not Root or not Root.Parent then
            stopFly()
            return
        end

        local camera=workspace.CurrentCamera
        local move=Vector3.zero

        if Keys.W then move+=camera.CFrame.LookVector end
        if Keys.S then move-=camera.CFrame.LookVector end
        if Keys.A then move-=camera.CFrame.RightVector end
        if Keys.D then move+=camera.CFrame.RightVector end
        if Keys.Space then move+=Vector3.yAxis end
        if Keys.LeftControl or Keys.RightControl then
            move-=Vector3.yAxis
        end

        if move.Magnitude>0 then
            move=move.Unit
        end

        Velocity.Velocity=move*State.Speed
        Gyro.CFrame=camera.CFrame
    end)
end

local function stopClip()
    State.NoClip=false
    if ClipConnection then
        ClipConnection:Disconnect()
        ClipConnection=nil
    end

    if Character then
        for _,part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide=true
            end
        end
    end
end

local function startClip()
    if not Character then return end
    if State.NoClip then return end

    State.NoClip=true

    ClipConnection=RunService.Stepped:Connect(function()
        if not State.NoClip or not Character then return end
        for _,part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide=false
            end
        end
    end)
end

local function setupCharacter(char)
    stopFly()
    stopClip()

    Character=char
    Humanoid=char:WaitForChild("Humanoid")
    Root=char:WaitForChild("HumanoidRootPart")

    Humanoid.Died:Connect(function()
        stopFly()
        stopClip()
    end)
end

if Player.Character then
    setupCharacter(Player.Character)
end

