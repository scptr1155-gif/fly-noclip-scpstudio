local Entrance = {}
local function register(obj, kind, slide)
	local target = 0
	if kind == "text" then
		target = obj.TextTransparency
		obj.TextTransparency = 1
	elseif kind == "stroke" then
		target = obj.Transparency
		obj.Transparency = 1
	else
		target = obj.BackgroundTransparency
		obj.BackgroundTransparency = 1
	end
	-- Konum yalnızca kaydırılacak GuiObject'lerde okunur (UIStroke vb. 'de Position' yok)
	local pos = nil
	if slide then
		pos = obj.Position
	end
	Entrance[#Entrance + 1] = {obj = obj, kind = kind, target = target, pos = pos, slide = slide}
end

