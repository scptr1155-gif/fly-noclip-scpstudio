local Token = {ok = false, exp = 0}

local function stateSig(ok, exp, uid, beat)
	return mac(ok and "1" or "0", tostring(exp), tostring(uid), tostring(beat))
end

function Token.write()
	local t = nowTime()
	Env[K.K_STATE] = {
		ok = Token.ok, exp = Token.exp, uid = Player.UserId, beat = t,
		sig = stateSig(Token.ok, Token.exp, Player.UserId, t),
	}
end

function Token.set(ok, exp)
	Token.ok = ok
	Token.exp = ok and exp or 0
	Token.write()
end

local function normalizeKey(text)
	return ((tostring(text or ""):gsub("%s+", "")):upper())
end

local function isErr(x)
	return type(x) == "string" and x:match("^E%d%d$") ~= nil
end

local function copyText(text)
	local fn = getGlobal("setclipboard") or getGlobal("toclipboard")
	return type(fn) == "function" and pcall(fn, text)
end

