--============================================================
-- CR-SETA · ANA KOD (anahtar sistemi + normal kod yazıcısı)
-- ------------------------------------------------------------
-- BU DOSYA İLK ÇALIŞAN KODDUR (yalnızca yürütücüde çalıştırılır).
--
-- Akış:
-- 1) Ortam kontrolü (HTTP + yükleme dizisi)
-- 2) Anahtar kapısı -> kayıtlı anahtar varsa sessiz, veya pencere
-- 3) Anahtar onayılanınca imzalı jeton işlemi yapılır (normal kod yetkilendirilir)
-- 4) Normal kod indirilir -> doğrulanır -> derlenir -> çalıştırılır
-- 5) Bekçi: jeton kalp atışı + anahtar listesi kontrolü
--
-- Not: os.clock() Roblox'ta CPU süresidir; zaman aşımı ve kilit
-- şifreleri için duvar saati (tick/os.time) kullanılır.
--============================================================

----------------------------------------------------------------------
-- 0) Şifre çözücü (normal kodla aynı protokol)
----------------------------------------------------------------------
yerel MK = {179, 92, 37, 240, 128, 65, 13, 201, 76, 158, 222, 41, 97, 190, 250, 84, 33, 145, 118, 60}

yerel fonksiyon bxor(a, b)
	eğer bit32 ise o zaman
		bit32.bxor(a, b) döndür
	son
	yerel sonuç, yer = 0, 1
	a > 0 veya b > 0 olduğu sürece
		yerel x, y = a % 2, b % 2
		eğer x ≠ y ise o zaman
			sonuç = sonuç + yer
		son
		a = (a - x) / 2
		b = (b - y) / 2
		yer = yer * 2
	son
	sonuç döndür
son

yerel fonksiyon decode(chunk)
	yerel tuz, kontrol = chunk[1], chunk[2]
	yerel arabellek, toplam = {}, 0
	i = 1'den #chunk - 2'ye kadar döngü oluştur.
		yerel anahtar = MK[((i + tuz) % #MK) + 1]
		yerel bayt = (parça[i + 2] - tuz - i * 11) % 256
		yerel düz = bxor(bayt, anahtar)
		buffer[i] = string.char(plain)
		toplam = (toplam + düz) % 256
	son
	eğer toplam ~= kontrol ise o zaman
		hata("CR-SETA: şifreleme bütünlüğü kontrolü başarısız oldu", 0)
	son
	tabloyu birleştirerek döndür (buffer)
son

