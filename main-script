-- Yerel kayıt: anahtarın ilk kullanım zamanı (MAC ile korunur)
yerel Mağaza = {raw = nil}

yerel fonksiyon loadStore()
	yerel mağaza = {başlangıç ​​= {}, son = nil}
	yerel ham = Store.raw
	yerel dosya, dosya oku = getGlobal(K.K_IF), getGlobal(K.K_RF)
	if type(isfile) == "function" and type(readfile) == "function" then
		yerel tamam, veri = pcall(fonksiyon()
			eğer K.K_FILE dosya ise
				readfile(K.K_FILE) fonksiyonunu döndür.
			son
		son)
		eğer uygunsa ve type(data) == "string" ise
			ham = veri
		son
	son
	for line in tostring(raw or ""):gmatch("[^\r\n]+") do
		yerel tür, a, b, c = satır:eşleştir("^(%a)|([^|]*)|([^|]*)|?([^|]*)$")
		eğer kind == "K" ve mac("K", a, b) == c ise
			mağaza.başlatıldı[a] = tonumber(b)
		aksi takdirde eğer kind == "L" ve mac("L", a) == b ise o zaman
			mağaza.son = bir
		son
	son
	mağazaya geri dön
son

yerel fonksiyon saveStore(store)
	yerel satırlar = {}
	id için, çiftler halinde başlatıldı (store.started) do
		lines[#lines + 1] = string.format("K|%s|%s|%s", id, tostring(started), mac("K", id, tostring(started)))
	son
	eğer store.last ise o zaman
		lines[#lines + 1] = string.format("L|%s|%s", store.last, mac("L", store.last))
	son
	yerel veri = tablo.concat(satırlar, "\n")
	Store.raw = data
	yerel yazma dosyası = getGlobal(K.K_WF)
	if type(writefile) == "function" then
		pcall(writefile, K.K_FILE, data)
	son
son

-- true, bitişZamanı, kod | yanlış, sebep, ayrıntı
yerel fonksiyon verifyKey(giriş, keysOverride)
	yerel kod = normalizeKey(giriş)
	eğer kod == "" ise o zaman
		false döndür, "boş"
	son
	yerel anahtarlar, sebep, detay = keysOverride, nil, nil
	anahtarlar değilse o zaman
		anahtarlar, neden, detay = Anahtarlar.getir()
	son
	anahtarlar değilse o zaman
		false döndür, sebep, detay
	son
	eğer anahtarlar [kod] değilse o zaman
		false döndür, "geçersiz"
	son
	yerel mağaza = loadStore()
	yerel kimlik = khash(kod)
	yerel t = şimdiZaman()
	yerel başlatıldı = mağaza.başlatıldı[id]
	başlatılmadıysa
		başladı = t
		mağaza.başlatıldı[id] = başlatıldı
	son
	eğer t >= started + CFG.KeyLifetime ise
		false döndür, "süresi doldu", "anahtarın kullanım ömrü sona erdi"
	son
	mağaza.son = kod
	saveStore(store)
	true döndür, başlatıldı + CFG.KeyLifetime, kod
son

