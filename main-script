-- fxBase: butonun "gerçek" rengi. Durum değişince güncellenir;
-- böylece hover çıkışı eski rengi geri getirip seçimi bozmaz.
local fxBase = {}

local function fx(button, radius, hoverColor, manageStroke)
	local baseColor = button.BackgroundColor3
	local hasStroke = manageStroke ~= false and button:FindFirstChildOfClass(S.STROKE)
	local scale = new(S.SCALE, {}, button)
	fxBase[button] = baseColor

	button.MouseEnter:Connect(function()
		if hoverColor then
			tween(button, 0.18, {BackgroundColor3 = hoverColor})
		end
		if hasStroke then
			tween(hasStroke, 0.18, {Transparency = math.max(0, hasStroke.Transparency - 0.15)})
		end
	end)
	button.MouseLeave:Connect(function()
		tween(button, 0.22, {BackgroundColor3 = fxBase[button] or baseColor})
		if hasStroke then
			tween(hasStroke, 0.22, {Transparency = math.min(0.7, hasStroke.Transparency + 0.15)})
		end
		tween(scale, 0.12, {Scale = 1})
	end)
	button.MouseButton1Down:Connect(function()
		tween(scale, 0.08, {Scale = 0.97})
	end)
	button.MouseButton1Up:Connect(function()
		tween(scale, 0.18, {Scale = 1}, Ease.Back)
	end)

	return scale
end

-- sürükleme takibi (global dinleyici yalnızca sürükleme sırasında açık)
local function trackDrag(handle, onBegin, onMove, onEnd)
	handle.InputBegan:Connect(function(input)
		if not isPointer(input) then
			return
		end

		local moveConn, endConn
		local function stop()
			if moveConn then
				moveConn:Disconnect()
				moveConn = nil
			end
			if endConn then
				endConn:Disconnect()
				endConn = nil
			end
			if onEnd then
				onEnd()
			end
		end

		if onBegin(input) == false then
			return
		end
		moveConn = UIS.InputChanged:Connect(function(changed)
			if changed.UserInputType == UserInputType.MouseMovement or changed == input then
				onMove(changed)
			end
		end)
		endConn = UIS.InputEnded:Connect(function(changed)
			if changed == input or changed.UserInputState == UserInputState.End then
				stop()
			end
		end)
	end)
end

