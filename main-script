local function runKeyGate(message)
	local ui = new("ScreenGui", {Name = "crseta_key", ResetOnSpawn = false, DisplayOrder = 100}, PlayerGui)
	-- Modal: Shift Lock / oyun fare kilidi açıkken bile fare serbest kalır
	new("TextButton", {Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true}, ui)

	local card = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 20),
		Size = UDim2.fromOffset(360, 262),
		BackgroundColor3 = COLORS.bgTop,
		BorderSizePixel = 0,
	}, ui)
	corner(card, 18)
	local cardStroke = stroke(card, COLORS.accent, 1.8, 0.1)
	local cardGradient = new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, COLORS.accent),
			ColorSequenceKeypoint.new(0.5, COLORS.accent2),
			ColorSequenceKeypoint.new(1, COLORS.accent),
		}),
	}, cardStroke)
	TweenService:Create(cardGradient, TweenInfo.new(4, Ease.Linear, EaseDir.In, -1), {Rotation = 360}):Play()
	local cardScale = new("UIScale", {Scale = 0.85}, card)

	local title = new("TextLabel", {
		Position = UDim2.fromOffset(20, 16), Size = UDim2.new(1, -40, 0, 26),
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 21,
		TextColor3 = COLORS.text, TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	local sub = new("TextLabel", {
		Position = UDim2.fromOffset(20, 44), Size = UDim2.new(1, -40, 0, 16),
		BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12,
		TextColor3 = COLORS.muted, TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local box = new("TextBox", {
		Position = UDim2.fromOffset(20, 76), Size = UDim2.new(1, -40, 0, 44),
		BackgroundColor3 = COLORS.panel, Font = Enum.Font.GothamSemibold, TextSize = 15,
		TextColor3 = COLORS.text, PlaceholderColor3 = COLORS.muted, Text = "",
		ClearTextOnFocus = false,
	}, card)
	corner(box, 11)
	local boxStroke = stroke(box, COLORS.button, 1.4, 0)

	local enterBtn = new("TextButton", {
		Position = UDim2.fromOffset(20, 134), Size = UDim2.new(0.5, -26, 0, 42),
		BackgroundColor3 = COLORS.accent, AutoButtonColor = false,
		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = COLORS.text,
	}, card)
	corner(enterBtn, 11)
	fx(enterBtn, 11, Color3.fromRGB(40, 185, 255))

	local getBtn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 134),
		Size = UDim2.new(0.5, -26, 0, 42), BackgroundColor3 = COLORS.discord,
		AutoButtonColor = false, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = COLORS.text,
	}, card)
	corner(getBtn, 11)
	fx(getBtn, 11, COLORS.discordHover)

	local linkBox = new("TextBox", {
		Position = UDim2.fromOffset(20, 186), Size = UDim2.new(1, -40, 0, 30),
		BackgroundColor3 = COLORS.panel, Font = Enum.Font.Gotham, TextSize = 11,
		TextColor3 = COLORS.text, Text = K.K_URL, TextEditable = false,
		ClearTextOnFocus = false, Visible = false,
	}, card)
	corner(linkBox, 8)

	local status = new("TextLabel", {
		Position = UDim2.fromOffset(20, 222), Size = UDim2.new(1, -40, 0, 30),
		BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, TextSize = 12,
		TextColor3 = COLORS.muted, TextWrapped = true, Text = message or "",
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	}, card)

	local function setStatus(text, color)
		status.Text = text
		status.TextColor3 = color or COLORS.muted
	end
	local function applyTexts()
		title.Text, sub.Text = kt("title"), kt("sub")
		box.PlaceholderText = kt("placeholder")
		enterBtn.Text, getBtn.Text = kt("enter"), kt("get")
	end
	applyTexts()
	if message then
		setStatus(message, COLORS.red)
	end
	tween(cardScale, 0.4, {Scale = 1}, Ease.Back)
	tween(card, 0.4, {Position = UDim2.new(0.5, 0, 0.5, 0)}, Ease.Quint)

	local result = Instance.new("BindableEvent")
	local busy, fails, lockedUntil = false, 0, 0

	local function shake()
		local base = card.Position
		for _, dx in ipairs({-8, 8, -5, 5, 0}) do
			tween(card, 0.05, {Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset)})
			task.wait(0.05)
		end
		tween(boxStroke, 0.4, {Color = COLORS.button})
	end

	local function submit()
		if busy then
			return
		end
		local t = os.clock()
		if t < lockedUntil then
			setStatus(kt("wait") .. math.ceil(lockedUntil - t) .. "s", COLORS.red)
			return
		end
		busy = true
		setStatus(kt("checking"), COLORS.muted)
		local ok, a = verifyKey(box.Text)
		if ok then
			local remaining = a - nowTime()
			setStatus(kt("ok") .. formatRemaining(remaining), COLORS.green)
			tween(boxStroke, 0.2, {Color = COLORS.green})
			task.wait(0.7)
			tween(cardScale, 0.25, {Scale = 0.85}, Ease.Back, EaseDir.In)
			task.wait(0.25)
			ui:Destroy()
			keyToast(kt("ok") .. formatRemaining(remaining), COLORS.green)
			result:Fire(a)
			return
		end
		if a ~= "net" and a ~= "empty" then
			fails += 1
			if fails >= 5 then
				fails = 0
				lockedUntil = os.clock() + 20
			end
		end
		setStatus(kt(a) or a, COLORS.red)
		tween(boxStroke, 0.15, {Color = COLORS.red})
		shake()
		busy = false
	end

	enterBtn.Activated:Connect(submit)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
	getBtn.Activated:Connect(function()
		if copyText(K.K_URL) then
			linkBox.Visible = false
			setStatus(kt("copied"), COLORS.green)
		else
			linkBox.Visible = true
			setStatus(kt("manual"), COLORS.muted)
			pcall(function()
				linkBox:CaptureFocus()
			end)
		end
	end)

	return result.Event:Wait()
end


