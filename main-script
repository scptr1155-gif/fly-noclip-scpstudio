-- 4) HTTP katmanı (kasmanın asıl sebebi burasıydı)
--    - Önce request() kullanılır: sadece o thread'i bekletir, oyunu dondurmaz
--    - request yoksa / hata verirse game:HttpGet yedek olarak kullanılır
--------------------------------------------------------------------
local lastFetchError = ""

local requestFn = (syn and syn.request) or (http and http.request) or http_request or request

-- Başarılıysa içerik, başarısızsa nil + hata metni döner
local function httpGet(url)
    if requestFn then
        local ok, r = pcall(requestFn, {Url = url, Method = "GET"})
        if ok and type(r) == "table" then
            local code = r.StatusCode or r.status_code
            if code == 200 and type(r.Body) == "string" then return r.Body end
            if code then return nil, "HTTP " .. tostring(code) end
        end
        -- request çalışmadıysa aşağıda game:HttpGet denenir
    end

    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" then return res end
    return nil, tostring(res)
end

local function fetchFile(url)
    local res, err = httpGet(url .. "?t=" .. tostring(os.time()))
    if not res then
        lastFetchError = err or "unknown error"
        return nil
    end
    res = res:gsub("^\239\187\191", "")
    if res:match("^404: Not Found") then
        lastFetchError = "404 not found"
        return nil
    end
    return res
end

