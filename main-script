		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 48), Size = UDim2.new(1, -40, 0, 18),
		BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.muted, TextTransparency = 1,
	}, s.loading)
